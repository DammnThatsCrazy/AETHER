{
  "schema_version": 1,
  "canonical_source": "config/telemetry_contracts.json",
  "events": [
    {
      "id": "verification.route.evaluated",
      "description": "The local change-aware router selected verification evidence for a path set.",
      "producer": "scripts/check_router.py",
      "data_classification": "operational_metadata",
      "fields": {
        "changed_files": {"type": "array", "items": "string", "required": true},
        "affected_domains": {"type": "array", "items": "string", "required": true},
        "minimum_lane": {"type": "string", "enum": ["fast", "pr", "integration", "regression", "release"], "required": true},
        "selected_lane": {"type": "string", "enum": ["fast", "pr", "integration", "regression", "release"], "required": true},
        "followup_required": {"type": "boolean", "required": true},
        "selected_checks": {"type": "array", "items": "string", "required": true},
        "affected_tests": {"type": "array", "items": "string", "required": true},
        "global_change": {"type": "boolean", "required": true}
      }
    },
    {
      "id": "impact.graph.indexed",
      "description": "The repository impact graph resolved direct and transitive delivery scope.",
      "producer": "scripts/impact_graph.py",
      "data_classification": "operational_metadata",
      "fields": {
        "changed_files": {"type": "array", "items": "string", "required": true},
        "direct_nodes": {"type": "array", "items": "string", "required": true},
        "impacted_components": {"type": "array", "items": "string", "required": true},
        "impacted_contracts": {"type": "array", "items": "string", "required": true},
        "impacted_deployables": {"type": "array", "items": "string", "required": true},
        "transitive_nodes": {"type": "array", "items": "string", "required": true},
        "unresolved_paths": {"type": "array", "items": "string", "required": true},
        "router_minimum_lane": {"type": "string", "enum": ["fast", "pr", "integration", "regression", "release"], "required": true},
        "router_selected_lane": {"type": "string", "enum": ["fast", "pr", "integration", "regression", "release"], "required": true},
        "router_followup_required": {"type": "boolean", "required": true}
      }
    },
    {
      "id": "verification.shadow.comparison",
      "description": "A targeted impact scope was compared with a legacy broad scope.",
      "producer": "scripts/impact_graph.py",
      "data_classification": "operational_metadata",
      "fields": {
        "classification": {"type": "string", "enum": ["equivalent", "targeted_miss", "legacy_broad_result", "targeted_miss_and_legacy_broad", "legacy_narrow_result"], "required": true},
        "expected_nodes": {"type": "array", "items": "string", "required": true},
        "targeted_nodes": {"type": "array", "items": "string", "required": true},
        "legacy_nodes": {"type": "array", "items": "string", "required": true},
        "targeted_missing": {"type": "array", "items": "string", "required": true},
        "legacy_extra": {"type": "array", "items": "string", "required": true},
        "legacy_missing": {"type": "array", "items": "string", "required": true}
      }
    },
    {
      "id": "delivery.operation.completed",
      "description": "A profile-aware hosted delivery operation emitted typed outcome and timing metadata.",
      "producer": "scripts/release/profile_delivery_contracts.py",
      "data_classification": "operational_metadata",
      "fields": {
        "operation_id": {"type": "string", "required": true},
        "operation": {"type": "string", "enum": ["wake", "sleep", "deploy", "validate", "promote", "rollback", "reconcile", "destroy"], "required": true},
        "profile": {"type": "string", "required": true},
        "release_candidate_id": {"type": "string", "required": true},
        "commit_sha": {"type": "string", "required": true},
        "artifact_digest": {"type": "string", "required": true},
        "status": {"type": "string", "enum": ["DRY_RUN", "BLOCKED", "FAILED", "DEPLOYED", "VALIDATED", "PROMOTED", "ROLLED_BACK", "SLEPT"], "required": true},
        "mutation_occurred": {"type": "boolean", "required": true},
        "retryable": {"type": "boolean", "required": true},
        "resumed": {"type": "boolean", "required": true},
        "duration_seconds": {"type": "integer", "required": true},
        "queue_seconds": {"type": "integer", "required": true},
        "setup_seconds": {"type": "integer", "required": true},
        "execution_seconds": {"type": "integer", "required": true},
        "cache_hit": {"type": "boolean", "required": true},
        "failure_category": {"type": "string", "required": true},
        "next_action": {"type": "string", "required": true},
        "evidence_ref": {"type": "string", "required": true}
      }
    }
  ]
}
