FROM rust:1.85-slim-bookworm AS builder
ARG TFMCP_VERSION="0.2.2"
ARG TFMCP_REVISION="unknown"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch v${TFMCP_VERSION} https://github.com/nwiizo/tfmcp.git /app/tfmcp-src || (echo "Failed to clone tfmcp" && exit 1)
WORKDIR /app/tfmcp-src
RUN cargo build --release --bin tfmcp

FROM hashicorp/terraform:1.9.5 AS terraform

FROM debian:trixie-slim
ARG TFMCP_VERSION="0.2.2"
LABEL io.modelcontextprotocol.server.name="io.github.nwiizo/tfmcp" org.opencontainers.image.title="tfmcp" org.opencontainers.image.description="Aether-hosted Terraform MCP server" org.opencontainers.image.source="https://github.com/nwiizo/tfmcp" org.opencontainers.image.version="${TFMCP_VERSION}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/tfmcp-src/target/release/tfmcp /usr/local/bin/tfmcp
COPY --from=terraform /bin/terraform /usr/local/bin/terraform
ENV RUST_LOG=info
ENTRYPOINT ["tfmcp"]
CMD ["mcp", "--toolsets", "all"]
