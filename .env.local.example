# ============================================================================
# Aether — LOCAL development environment example
# Copy to .env for local dev. Backend runs fully in-memory; no external
# services required. Frontends default to MSW-mocked mode.
# See docs/LOCAL-DEVELOPMENT.md and docs/ENVIRONMENT-VARIABLES.md.
# ============================================================================

AETHER_ENV=local
DEBUG=true
LOG_LEVEL=debug

# No DATABASE_URL / JWT_SECRET required in local: in-memory repositories are used
# and a dev JWT secret default applies. Set these only to test against real infra.
# DATABASE_URL=postgresql://aether:aether@localhost:5432/aether
# JWT_SECRET=local-dev-only-change-me

# All optional providers/integrations stay OFF locally — no keys needed.
STRIPE_BILLING_ENABLED=false
AETHER_EXTERNAL_BILLING_ENABLED=false
AETHER_STRIPE_BILLING_ENABLED=false
AETHER_DATA_QUALITY_ENABLED=true            # safe to explore locally (in-memory)
KYBER_INTELLIGENCE_QUALITY_ENABLED=true
EMAIL_ENABLED=false

# Demo (Phase 3) — local demo runs on MSW fixtures; seed endpoints stay off.
DEMO_MODE=true
AETHER_DEMO_SEED_ENABLED=false

# Partner ecosystem stays future-flagged off everywhere.
AETHER_PARTNER_ECOSYSTEM_ENABLED=false
AETHER_MARKETPLACE_ENABLED=false
AETHER_DEVELOPER_PLATFORM_ENABLED=false
KYBER_PARTNER_ECOSYSTEM_ENABLED=false

# Frontends: copy frontend/<app>/.env.example and use the live local backend.
# VITE_AETHER_ENV=local  VITE_KYBER_ENV=local  VITE_DEMO_ENV=local

# === Reconciled Control Plane (managed-integration reconciliation) ===
# Phase 0 ships the ManagedIntegration abstraction + reconcile skeleton only.
# All flags OFF: there is no live reconcile trigger and no actuator in Phase 0.
AETHER_RECONCILED_CONTROL_PLANE_ENABLED=false            # master switch for the plane
AETHER_RECONCILED_CONTROL_RECONCILER_ENABLED=false       # reconcile skeleton (tests-only in Phase 0)
AETHER_RECONCILED_CONTROL_KYBER_ROUTE_ENABLED=false      # read-only GET /v1/admin/kyber/managed-integrations
