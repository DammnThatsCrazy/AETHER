.terraform/
*.tfplan
tfplan

# ML artifacts
*.onnx
*.tflite
*.h5
*.pt
*.pkl
mlruns/
mlflow.db
.claude/worktrees/
# Claude Code session-specific tool permissions (environment-specific, not shared)
.claude/settings.local.json

# Generated SBOM artifacts (supply-chain gate output)
reports/sbom/

# Generated cost model reports (check_cost_model.py output)
reports/cost/

# Terraform plan-policy inventory and policy reports
# (scripts/release/check_terraform_plan_policy.py --out-dir, and the
# infrastructure / terraform-promote workflows write here)
artifacts/

# Multidimensional readiness artifacts are committed deliverables, regenerated
# deterministically by `make readiness-artifacts` (scripts/readiness_status.py
# --emit-artifacts, scripts/migrate_readiness_data.py --write).
!artifacts/readiness/
!artifacts/readiness/**

# Release evidence bundle (scripts/release/collect_evidence.py --bundle-dir).
# Only created on an explicit flag, but never a committed artifact: it is
# per-run evidence, and a stale committed copy would be worse than none.
release-evidence/

# Local Python virtualenv (toolchain isolation from system dist-packages)
.venv/

# FPS SDK keys (secrets — never commit)
.proof-keys.json

# Scratch + throwaway (excluded from PR)
tmp/
Smart Contracts/
.claude/settings.json
scripts/fix_logger_kwargs.py

# Site prerender server bundle (removed after each build)
apps/site/dist-ssr/
