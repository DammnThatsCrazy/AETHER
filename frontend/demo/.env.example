# Aether Demo App — closed, synthetic, fully-seeded demo environment.
# VITE_DEMO_ENV is REQUIRED and has no default: an unset value fails the build
# rather than silently starting MSW. Values are the canonical deployment
# profiles (config/deployment_profiles.yaml) the demo SPA may run as:
#   local-mocked  MSW fixtures, no backend
#   demo-static   static frontend, synthetic precomputed dataset, no backend
#   demo-live     shared non-production backend, synthetic tenant, no fixtures
VITE_DEMO_ENV=local-mocked
VITE_API_BASE_URL=http://localhost:8000
