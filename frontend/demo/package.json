{
  "name": "@aether/demo",
  "version": "8.12.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177",
    "build": "npm run build:profile",
    "build:profile": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5177",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "demo:seed": "npm --prefix ../.. run demo:seed",
    "demo:reset": "npm --prefix ../.. run demo:reset",
    "demo:status": "npm --prefix ../.. run demo:status"
  },
  "dependencies": {
    "@aether/shared": "*",
    "@aether/ui": "*",
    "@aether/web": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
