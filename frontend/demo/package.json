{
  "name": "@aether/demo",
  "version": "8.12.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177",
    "build": "VITE_DEMO_ENV=local-mocked npm run build:profile",
    "build:profile": "tsc --noEmit && vite build",
    "build:local-mocked": "VITE_DEMO_ENV=local-mocked npm run build:profile",
    "build:demo-static": "VITE_DEMO_ENV=demo-static npm run build:profile",
    "build:demo-live": "VITE_DEMO_ENV=demo-live npm run build:profile",
    "preview": "vite preview --port 5177",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "demo:seed": "node -e \"console.log('Demo App is fixture-driven (MSW); seed/reset are no-ops locally. See docs/DEMO-DATA.md')\"",
    "demo:reset": "node -e \"console.log('Demo reset: reload the app in local-mocked mode to restore synthetic fixtures.')\""
  },
  "dependencies": {
    "@aether/shared": "*",
    "@aether/ui": "*",
    "@aether/web": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^25.0.0",
    "msw": "^2.14.6",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
