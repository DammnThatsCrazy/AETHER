# =============================================================================
# Olympus Marketing — public static shell (olympuslabs.com)
# Copy to .env.local for local builds, or set the same keys in the static-host
# provider at deploy time. All VITE_* values below are read at build time by
# src/lib/env.ts (site topology) and src/lib/analytics.ts (analytics).
#
# Honesty ceiling: every origin below is a TARGET origin for the web ecosystem.
# None of these hosts is deployed or serving traffic today. Setting a value here
# never publishes anything; it only configures what links/canonicals the build
# would emit. See docs/deployment/WEB_ECOSYSTEM_DEPLOYMENT.md for the contract.
# =============================================================================

# ── Site topology (TARGET origins — none deployed) ───────────────────────────
# Olympus Labs corporate marketing origin (the shell that consumes this file).
VITE_OLYMPUS_SITE_URL=https://olympuslabs.com

# Aether public marketing origin.
VITE_AETHER_MARKETING_URL=https://aether.olympuslabs.com

# Protected Aether tenant application origin.
VITE_AETHER_APP_URL=https://app.olympuslabs.com

# Olympus Labs internal Kyber origin. Kyber stays private — it is NEVER linked
# from public marketing. Declared here only so the build-time topology is
# explicit and can never be invented ad hoc.
VITE_KYBER_URL=https://kyber.olympuslabs.com

# Aether documentation origin.
VITE_AETHER_DOCS_URL=https://docs.olympuslabs.com

# Aether public service status origin. This is a planned origin only; the real
# status source today is the tenant-safe backend /v1/status* API. The Olympus
# shell footer "Service status" link is env-driven, so this can later point at a
# real status page without a code change.
VITE_AETHER_STATUS_URL=https://status.olympuslabs.com

# ── Analytics (opt-in; OFF by default) ───────────────────────────────────────
# Options: off | plausible | ga4. The build injects NO analytics script while
# this is "off" (the default). This is configuration surface — setting a value
# here is not a claim that analytics is live anywhere.
VITE_ANALYTICS_PROVIDER=off

# Plausible site domain (e.g. olympuslabs.com) or GA4 measurement id
# (e.g. G-XXXXXXXXXX). Read only when VITE_ANALYTICS_PROVIDER is plausible|ga4;
# an empty value keeps analytics disabled even with a provider selected.
VITE_ANALYTICS_PROPERTY_ID=
