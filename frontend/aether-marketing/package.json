{
  "name": "@aether/aether-marketing",
  "version": "8.12.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Aether public marketing site (aether.olympuslabs.com) — platform, solutions, developers, integrations, security, pricing, resources, and the public Aether authentication threshold layout.",
  "scripts": {
    "dev": "vite --port 5179",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --port 5179",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aether/ui": "*",
    "@olympus/brand": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
