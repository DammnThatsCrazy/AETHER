# =============================================================================
# Aether — Customer App (Frontend Architecture)
# Copy to .env.local and fill in values for your environment.
# =============================================================================

# ── App environment ───────────────────────────────────────────────────────────
# Options: local | staging | production | test
VITE_AETHER_ENV=local

# ── Backend API ───────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_AETHER_API_KEY=
VITE_AETHER_ENDPOINT=http://localhost:8000

# ── Auth0 (required for staging and production) ───────────────────────────────
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.aether.io
VITE_AUTH0_REDIRECT_URI=http://localhost:5175/callback
VITE_AUTH0_LOGOUT_URI=http://localhost:5175/login
# VITE_AUTH0_CALLBACK_URL is used in Auth0 dashboard Allowed Callback URLs
# Set to: http://localhost:5175/callback (dev), https://app.aether.dev/callback (prod)

# ── OIDC (alternative to Auth0 — optional) ────────────────────────────────────
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:5175/callback
VITE_OIDC_SCOPE=openid profile email

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use pk_test_... for dev/staging, pk_live_... for production
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set VITE_ENTERPRISE_EMAIL_VERIFIED=true only after sales@aether.dev is live
VITE_ENTERPRISE_EMAIL_VERIFIED=false
VITE_ENTERPRISE_EMAIL=sales@aether.dev
