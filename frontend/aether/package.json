{
  "name": "@aether/aether",
  "version": "8.9.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5175",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@aether/shared": "*",
    "@aether/ui": "*",
    "@aether/web": "*",
    "cytoscape": "^3.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@auth0/auth0-react": "^2.16.2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/cytoscape": "^3.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "msw": "^2.14.6",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "@playwright/test": "^1.48.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
