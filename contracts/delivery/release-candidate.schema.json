{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.olympuslabs.io/contracts/delivery/release-candidate.schema.json",
  "title": "Aether ReleaseCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_candidate_id", "commit_sha", "artifact_digest", "dependency_lock_hash", "contract_versions", "migration_version", "model_versions", "policy_versions", "deployment_profiles", "affected_domains", "required_checks", "component_digests", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "release_candidate_id": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dependency_lock_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contract_versions": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
    "migration_version": {"type": "string"},
    "model_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "policy_versions": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
    "deployment_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "affected_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "required_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "component_digests": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
