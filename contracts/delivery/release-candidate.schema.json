{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.olympuslabsml.com/contracts/delivery/release-candidate.schema.json",
  "title": "Aether ReleaseCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_candidate_id", "commit_sha", "artifact_digest", "dependency_lock_hash", "dependency_lock_digests", "contract_versions", "migration_version", "model_versions", "policy_versions", "deployment_profiles", "affected_domains", "required_checks", "component_digests", "deployment_impact", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "release_candidate_id": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dependency_lock_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dependency_lock_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "contract_versions": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
    "migration_version": {"type": "string"},
    "model_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "policy_versions": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
    "deployment_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "affected_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "required_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "component_digests": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "deployment_impact": {"$ref": "#/$defs/deploymentImpact"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "deploymentImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile", "affected_domains", "affected_components", "migration_required", "data_contract_change", "security_sensitive", "rollback_required", "approval_required", "risk_level", "rationale"],
      "properties": {
        "schema_version": {"const": 1},
        "profile": {"type": "string", "minLength": 1},
        "affected_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "affected_components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "migration_required": {"type": "boolean"},
        "data_contract_change": {"type": "boolean"},
        "security_sensitive": {"type": "boolean"},
        "rollback_required": {"type": "boolean"},
        "approval_required": {"type": "boolean"},
        "risk_level": {"enum": ["low", "medium", "high", "critical"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
