{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.olympuslabs.io/contracts/delivery/profile-delivery-operation/v1",
  "title": "Aether ProfileDeliveryOperation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "operation", "profile", "candidate_identity", "requested_at", "dry_run"],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["wake", "sleep", "deploy", "validate", "promote", "rollback", "reconcile", "destroy"]},
    "profile": {"type": "string", "minLength": 1},
    "candidate_identity": {"$ref": "#/$defs/identity"},
    "requested_at": {"type": "string", "format": "date-time"},
    "ttl_hours": {"type": "integer", "minimum": 1, "maximum": 168},
    "staging_evidence": {"$ref": "#/$defs/identity"},
    "from_candidate": {"$ref": "#/$defs/identity"},
    "to_candidate": {"$ref": "#/$defs/identity"},
    "dry_run": {"type": "boolean"}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_candidate_id", "commit_sha", "artifact_digest", "profile"],
      "properties": {
        "release_candidate_id": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "profile": {"type": "string", "minLength": 1}
      }
    }
  }
}
