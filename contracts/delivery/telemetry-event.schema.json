{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.olympuslabs.io/contracts/delivery/telemetry-event/v1",
  "title": "Aether local telemetry event v1",
  "description": "Secret-free operational metadata validated against config/telemetry_contracts.json. This contract defines no hosted exporter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_name", "occurred_at", "producer", "data"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_name": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "data": {"type": "object"}
  }
}
