{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.olympuslabs.io/contracts/delivery/effective-iam-comparison/v1",
  "title": "Aether EffectiveIamComparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role_arn", "source", "mode", "status", "operations_total", "operations_passed", "blockers", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "role_arn": {"type": "string", "pattern": "^arn:[^:]+:iam::[0-9]{12}:role/.+"},
    "source": {"enum": ["offline_fixture", "aws_read_only"]},
    "mode": {"enum": ["offline", "live-evidence"]},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "operations_total": {"type": "integer", "minimum": 1},
    "operations_passed": {"type": "integer", "minimum": 0},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement_id", "action", "resource", "status", "reason"],
        "properties": {
          "statement_id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "resource": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "MISSING", "BLOCKED"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
