# =============================================================================
# Aether Platform — Environment Variables
#
# Copy to .env and customize for your environment:
#   cp .env.example .env
#
# All variables have sensible defaults for local development.
# Variables marked [REQUIRED IN PRODUCTION] must be set for non-local envs.
# =============================================================================

# === Frontend Apps (separate .env.example per app) ===
# apps/kyber/.env.example  — Kyber operator console (port 5174, VITE_KYBER_ENV)
# apps/aether/.env.example — Aether customer app   (port 5175, VITE_AETHER_ENV)

# === General ===
AETHER_ENV=local                       # local | dev | staging | production
DEBUG=true

# === Database — PostgreSQL (asyncpg) ===
# DATABASE_URL is the primary connection string used by repositories.
# Individual TSDB_* vars are kept for backward compatibility with deployment scripts.
DATABASE_URL=                            # [REQUIRED IN PRODUCTION] e.g. postgresql://aether:pass@db:5432/aether
TSDB_HOST=localhost
TSDB_PORT=5432
TSDB_DATABASE=aether
TSDB_USER=aether
TSDB_PASSWORD=                          # [REQUIRED IN PRODUCTION]
TSDB_POOL_MIN=5
TSDB_POOL_MAX=20

# === Database — Amazon Neptune (Graph) ===
# Neptune requires AWS infrastructure (VPC, IAM, cluster). When NEPTUNE_ENDPOINT
# is left as "localhost" in non-local environments, the backend will warn at
# startup and graph intelligence features (H2H/H2A/A2H/A2A) will be unavailable.
# Provision Neptune first, then set the cluster endpoint (e.g. <cluster>.cluster-xyz.us-east-1.neptune.amazonaws.com).
NEPTUNE_ENDPOINT=localhost               # [REQUIRED FOR GRAPH FEATURES]
NEPTUNE_PORT=8182
AWS_REGION=us-east-1

# === Cache — Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_SIZE=10

# === Database — DynamoDB ===
DYNAMODB_ENDPOINT=                      # Leave empty for AWS; set for local DynamoDB
DYNAMODB_TABLE_PREFIX=aether_

# === Database — OpenSearch ===
OPENSEARCH_ENDPOINT=localhost
OPENSEARCH_PORT=9200

# === Event Bus — Kafka / SNS+SQS ===
EVENT_BROKER=kafka                      # kafka | sns_sqs
KAFKA_BOOTSTRAP_SERVERS=localhost:9092   # [REQUIRED IN PRODUCTION] Used by aiokafka producer/consumer
KAFKA_BROKERS=localhost:9092            # Legacy alias
KAFKA_CONSUMER_GROUP=aether-backend
SNS_TOPIC_ARN=
SQS_QUEUE_URL=

# === API Configuration ===
CORS_ORIGINS=http://localhost:3000,https://app.aether.io
MAX_REQUEST_BODY_MB=10

# === Self-Serve Plans & Rate Limiting ===
# Active pricing strategy. Selects which subscription/overage rate sheet
# is used by the OverageCalculator at billing time. Validated A/B/C at
# startup.  A = Market Entry, B = Ideal/Fair, C = Premium.
PRICING_OPTION=B
# Days to retain Redis quota counters (rl:quota:* and rl:overage:*).
QUOTA_REDIS_TTL_DAYS=35
# Interval (seconds) for the background quota -> tenant_usage flusher.
QUOTA_FLUSH_INTERVAL_S=60

# === Authentication ===
JWT_SECRET=change-me-in-production      # [REQUIRED IN PRODUCTION] Generate: python scripts/generate_secrets.py
JWT_EXPIRY_MINUTES=60
ORACLE_SIGNER_PRIVATE_KEY=              # [REQUIRED IN PRODUCTION] secp256k1 key for oracle proofs. Generate: python scripts/generate_secrets.py

# === Intelligence Graph Feature Flags ===
IG_AGENT_LAYER=false
IG_COMMERCE_LAYER=false
IG_X402_LAYER=false
IG_ONCHAIN_LAYER=false
IG_TRUST_SCORING=false
IG_BYTECODE_RISK=false
IG_RPC_GATEWAY=false

# === QuickNode (Blockchain RPC) ===
QUICKNODE_API_KEY=
QUICKNODE_ENDPOINT=
QUICKNODE_X402_ENABLED=false
QUICKNODE_MAX_RPS=100

# === Provider Gateway ===
PROVIDER_GATEWAY_ENABLED=false
BYOK_ENCRYPTION_KEY=                    # [REQUIRED IN PRODUCTION] Fernet key for BYOK vault (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
PROVIDER_GATEWAY_ENCRYPTION_KEY=        # Legacy alias for BYOK_ENCRYPTION_KEY
ALCHEMY_API_KEY=
ALCHEMY_ENDPOINT=
INFURA_API_KEY=
INFURA_PROJECT_ID=
ETHERSCAN_API_KEY=
MORALIS_API_KEY=
PROVIDER_MAX_RETRIES=2
PROVIDER_CB_THRESHOLD=5
PROVIDER_CB_TIMEOUT_S=30
PROVIDER_METER_FLUSH_S=60

# === Model Extraction Defense ===
ENABLE_EXTRACTION_DEFENSE=false
ENABLE_OUTPUT_NOISE=true
ENABLE_WATERMARK=true
ENABLE_QUERY_ANALYSIS=true
WATERMARK_SECRET_KEY=aether-wm-default-change-me   # [REQUIRED IN PRODUCTION]
CANARY_SECRET_SEED=aether-canary-seed-change-me     # [REQUIRED IN PRODUCTION] Generate: python scripts/generate_secrets.py
EXTRACTION_KEY_RPM=60
EXTRACTION_KEY_RPH=1000
EXTRACTION_KEY_RPD=10000
EXTRACTION_IP_RPM=120
EXTRACTION_IP_RPH=3000
EXTRACTION_IP_RPD=30000
EXTRACTION_NOISE_STD=0.02
EXTRACTION_OUTPUT_PRECISION=2

# === Extraction Defense Mesh (distributed multi-identity layer) ===
ENABLE_EXTRACTION_MESH=false
EXTRACTION_BUDGET_ENABLED=true
EXTRACTION_EXPECTATION_ENABLED=true
EXTRACTION_POLICY_ENABLED=true
EXTRACTION_ATTRIBUTION_ENABLED=true
EXTRACTION_CANARY_SEED=aether-mesh-canary-seed       # [REQUIRED IN PRODUCTION] Generate: python scripts/generate_secrets.py
EXTRACTION_TELEMETRY_ENABLED=true
EXTRACTION_PRIVILEGED_TENANTS=                         # Comma-separated tenant IDs exempt from mesh
EXTRACTION_PRIVILEGED_API_KEYS=                        # Comma-separated API keys exempt from mesh
EXTRACTION_BATCH_INTERNAL_ONLY=true
EXTRACTION_ALERT_ON_ORANGE=true
EXTRACTION_ALERT_ON_RED=true

# === Stripe Billing ===
# Stripe-managed subscription billing for the AETHER P1-P4 plan catalog.
# When STRIPE_BILLING_ENABLED=true in non-local environments, the secret key,
# webhook secret, P1-P4 price IDs, and checkout/portal URLs are required.
# In AETHER_ENV=local, missing Stripe config is permitted: checkout/portal
# routes will return mocked URLs instead of failing.
# STRIPE_OVERAGE_PRICE_ID is OPTIONAL — required ONLY if charging AETHER
# overage usage through Stripe invoices. When unset, the existing AETHER
# overage calculation (shared/billing/overage.py) is used internally and no
# Stripe overage invoice can be created.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=                              # [REQUIRED IN PRODUCTION when STRIPE_BILLING_ENABLED]
STRIPE_WEBHOOK_SECRET=                          # [REQUIRED IN PRODUCTION when STRIPE_BILLING_ENABLED]
STRIPE_PRICE_P1=                                # Recurring subscription Price ID for P1 Hobbyist
STRIPE_PRICE_P2=                                # Recurring subscription Price ID for P2 Professional
STRIPE_PRICE_P3=                                # Recurring subscription Price ID for P3 Growth Intelligence
STRIPE_PRICE_P4=                                # Recurring subscription Price ID for P4 Protocol Master
STRIPE_OVERAGE_PRICE_ID=                        # OPTIONAL — Price ID for Stripe-charged overage line items
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing

# === Smart Contracts (EVM Chains) ===
# Set after deploying with: npx hardhat run scripts/deploy.js --network <network>
ANALYTICS_REWARDS_ADDRESS=               # AnalyticsRewards contract address
REWARD_REGISTRY_ADDRESS=                 # RewardRegistry contract address
REWARD_TOKEN_ADDRESS=                    # ERC-20 token used for reward payouts
DEPLOYER_KEY=                            # [KEEP OFFLINE] Deployer wallet private key
ORACLE_ADDRESS=                          # Oracle signer address (from generate_secrets.py)
# Block explorer API keys (for contract verification)
ETHERSCAN_KEY=
POLYGONSCAN_KEY=
ARBISCAN_KEY=
BASESCAN_KEY=
OPTIMISM_ETHERSCAN_KEY=
# EVM chain RPC overrides (optional — defaults to public RPCs)
ETHEREUM_RPC=
ETHEREUM_TESTNET_RPC=
POLYGON_RPC=
POLYGON_TESTNET_RPC=
ARBITRUM_RPC=
ARBITRUM_TESTNET_RPC=
BASE_RPC=
BASE_TESTNET_RPC=
OPTIMISM_RPC=
OPTIMISM_TESTNET_RPC=

# === GeoIP Enrichment (MaxMind GeoLite2) ===
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=/usr/share/GeoIP/GeoLite2-ASN.mmdb

# === Agent Layer ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_CONCURRENCY=8

# === ML Serving ===
ML_SERVING_URL=http://localhost:8080

# === Data Ingestion (Node.js) ===
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
BATCH_SIZE=500
MAX_EVENT_SIZE_KB=32

# === Social API Keys (Agent Workers) ===
TWITTER_BEARER_TOKEN=
DISCORD_BOT_TOKEN=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=

# === Market Data Providers ===
COINGECKO_API_KEY=                         # Optional — free tier works without key
BINANCE_API_KEY=                           # [REQUIRED for CEX data]
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# === Prediction Market Providers ===
POLYMARKET_API_KEY=                        # Optional — public API available
KALSHI_API_KEY=                            # [REQUIRED for Kalshi]
KALSHI_API_SECRET=

# === Web3 Social Providers ===
FARCASTER_API_KEY=                         # Neynar API key for Farcaster data
LENS_API_KEY=                              # Optional — Lens Protocol API token

# === Identity Enrichment ===
ENS_SUBGRAPH_URL=                          # Optional — custom ENS subgraph endpoint
GITHUB_PAT=                                # GitHub Personal Access Token

# === Governance ===
SNAPSHOT_GRAPHQL_URL=                      # Optional — custom Snapshot hub endpoint

# === On-Chain Intelligence (contract required) ===
CHAINALYSIS_API_KEY=                       # Chainalysis risk API (requires contract)
NANSEN_API_KEY=                            # Nansen wallet labels (requires contract)

# === TradFi Data (subscription required) ===
MASSIVE_API_KEY=                           # Massive alternative data (requires contract)
DATABENTO_API_KEY=                         # Databento market data (requires subscription)

# === Observability ===
GRAFANA_ADMIN_PASSWORD=admin               # [REQUIRED IN PRODUCTION] Generate: python scripts/generate_secrets.py

# === Data Lake / Iceberg ===
ICEBERG_CATALOG_URI=                       # Optional — REST catalog URI (e.g. http://nessie:19120/api/v1)
ICEBERG_S3_BUCKET=aether-snapshots-dev     # S3 bucket for Iceberg snapshot storage

# === Security & Governance (Kyber operator access) ===
# No Aether tenant may access Kyber. An operator is recognised ONLY by one of these.
KYBER_OPERATOR_PERMISSION=kyber:operator   # Permission that marks an Olympus operator (tenants never have it)
KYBER_OPERATOR_TENANT_IDS=                 # Comma-separated internal operator tenant IDs allowed on Kyber

# === Data Quality / Drift / Intelligence Quality ===
# All default off; routes mount only when enabled. No external services required.
AETHER_DATA_QUALITY_ENABLED=false              # Tenant /v1/data-quality/* routes
KYBER_INTELLIGENCE_QUALITY_ENABLED=false       # Kyber /v1/admin/kyber/intelligence-quality/* routes
AETHER_DATA_QUALITY_WATCH_THRESHOLD=0.8        # Quality score below this → "watch"/"degraded"
AETHER_DATA_QUALITY_CRITICAL_THRESHOLD=0.6     # Quality score below this → "critical"

# === Inbound data-provider / connector ingestion ===
# Master switch OFF by default; per-connector enablement is per-tenant config.
# Provider credentials are required only when a connector is enabled for a tenant.
AETHER_CONNECTORS_ENABLED=false                # Mounts /v1/integrations/connectors/*
KYBER_CONNECTOR_HEALTH_ENABLED=false           # Mounts /v1/admin/kyber/connectors/* (aggregate)

# === Olympus-owned provider corpus + data lake (all off by default) ===
# Safety gates (provenance quarantine, data rights fail-closed) are always active.
# These flags gate route mounting and background jobs only.
AETHER_CONNECTOR_DATA_RIGHTS_ENABLED=false         # Mount /v1/integrations/data-rights routes
AETHER_CONNECTOR_BYOK_ENABLED=true                 # BYOK key vault routes (safe to enable; credential-only)
AETHER_CONNECTOR_ACTIONS_ENABLED=false             # Action/notifier connector delivery path
AETHER_CONNECTOR_OLYMPUS_PROVIDERS_ENABLED=false   # Olympus-owned provider connector registry
AETHER_PROVIDER_SOURCE_CATALOG_ENABLED=false       # Provider catalog API (tenant-facing, if ever)
KYBER_PROVIDER_SOURCE_CATALOG_ENABLED=false        # Mount /v1/admin/kyber/providers/* routes
AETHER_PROVIDER_SYNC_ENABLED=false                 # Background provider sync jobs
# Dune access modes (each gated separately; all require credentials)
AETHER_DUNE_DATASHARE_ENABLED=false                # Dune Datashare via Snowflake/BigQuery/Databricks
AETHER_DUNE_API_ENABLED=false                      # Dune API (parameterized SQL, requires DUNE_API_KEY)
AETHER_DUNE_SIM_ENABLED=false                      # Dune Sim/Echo (realtime wallet enrichment)
# Lake provenance and lineage
AETHER_PROVIDER_COST_PROFILES_ENABLED=false        # Cost profile tracking per provider
AETHER_PROVIDER_RATE_LIMIT_PROFILES_ENABLED=false  # Rate limit profile tracking per provider
AETHER_ENRICHMENT_LINEAGE_ENABLED=false            # Attach lineage_id to Gold / Profile360 / graph artifacts
AETHER_GRAPH_OF_GRAPHS_POLICY_ENABLED=false        # Graph-of-graphs data use policy enforcement
# Unique signal features (each requires external credentials — see UNIQUE_SIGNAL_FEATURES.md)
AETHER_UNIQUE_SIGNAL_FEATURES_ENABLED=false        # Enable unique cross-source signal computation
# Anti-distillation (score binning, honeypot, rapid-query detection)
AETHER_ANTI_DISTILLATION_ENABLED=false             # Enable intelligence API distillation protection
KYBER_ANTI_DISTILLATION_ENABLED=false              # Expose /v1/admin/kyber/intelligence/anti-distillation

# === External billing / payment provider readiness (behind flags) ===
# Defaults to internal-only; the internal billing/revops layer is unaffected when off.
# None of these are required for local dev unless provider sync is enabled.
AETHER_EXTERNAL_BILLING_ENABLED=false          # Master switch for the BillingProvider interface
AETHER_STRIPE_BILLING_ENABLED=false            # Activate the Stripe provider stub
KYBER_BILLING_PROVIDER_SYNC_ENABLED=false      # Expose provider-sync status in Kyber RevOps
BILLING_PROVIDER_MODE=internal_only            # internal_only | stripe | manual_invoice | enterprise_contract
STRIPE_PRODUCT_MAPPING_JSON=                   # Optional JSON: {"package_id": "prod_..."}
STRIPE_PRICE_MAPPING_JSON=                     # Optional JSON: {"P3": "price_...", "P3:recommendations": "price_..."}

# === OODA Suggestion Intelligence ===
# All off by default. Enable as each lifecycle phase is operationalised.
AETHER_SUGGESTIONS_ENABLED=false               # Master switch: mounts /v1/suggestions/* routes
AETHER_SUGGESTIONS_AUTODELIVERY_ENABLED=false  # Auto-deliver approved suggestions (no human gate)
AETHER_SUGGESTIONS_EXECUTION_ENABLED=false     # Allow suggestion execution (requires explicit opt-in)
AETHER_SUGGESTIONS_NOESIS_ENABLED=true         # Route suggestion intents through Noesis read-only handler
AETHER_SUGGESTIONS_RECOMMENDATION_ADAPTER_ENABLED=true   # Wire legacy recommendations → suggestions
AETHER_SUGGESTIONS_NOTIFICATION_ADAPTER_ENABLED=true     # Wire notification intelligence → suggestions
AETHER_SUGGESTIONS_DATA_QUALITY_ADAPTER_ENABLED=true     # Wire data quality drift events → suggestions
AETHER_SUGGESTIONS_SDK_HEALTH_ADAPTER_ENABLED=true       # Wire SDK silence/failure events → suggestions
AETHER_SUGGESTIONS_GRAPH_ADAPTER_ENABLED=true            # Wire graph events → suggestions
KYBER_SUGGESTIONS_ENABLED=true                 # Mount /v1/admin/kyber/suggestions/* operator routes
AETHER_TENANT_SUGGESTIONS_ENABLED=true         # Mount /v1/aether/suggestions/* tenant-safe routes

# === Partner ecosystem / marketplace / developer platform (FUTURE-FLAGGED ONLY) ===
# Intentionally NOT implemented in this pass. These flags default off and gate nothing yet.
AETHER_PARTNER_ECOSYSTEM_ENABLED=false
AETHER_MARKETPLACE_ENABLED=false
AETHER_DEVELOPER_PLATFORM_ENABLED=false
KYBER_PARTNER_ECOSYSTEM_ENABLED=false

# === Delivery Worker — durable provider dispatch + outcome tracking ===
# The DeliveryWorker polls delivery_jobs and dispatches via ProviderAdapters.
# Provider credentials are stored in the vault (ProvidersRepository), never here.
AETHER_DELIVERY_WORKER_ENABLED=true            # Enable the background delivery worker
DELIVERY_WORKER_BATCH_SIZE=10                  # Jobs claimed per poll cycle
DELIVERY_WORKER_LEASE_SECONDS=120              # Lease expiry window (seconds)
DELIVERY_WORKER_POLL_INTERVAL_S=5              # Poll interval when queue is empty
DELIVERY_WORKER_MAX_ATTEMPTS=5                 # Max dispatch attempts before dead-letter

# Slack (system-level default; per-tenant configured in UserNotificationChannel)
DELIVERY_SLACK_BOT_TOKEN=                      # xoxb-... Bot token for system-level Slack delivery
DELIVERY_SLACK_DEFAULT_CHANNEL=#aether-notifications

# Outbound webhook signing (used for X-Aether-Signature header)
DELIVERY_WEBHOOK_SIGNING_SECRET=               # HMAC-SHA256 signing secret for outbound webhooks

# Linear (system-level default API key; per-tenant keys stored in vault)
DELIVERY_LINEAR_API_KEY=                       # Linear API key for issue creation

# Jira (system-level default; per-tenant configured in connector config)
DELIVERY_JIRA_BASE_URL=                        # e.g. https://mycompany.atlassian.net
DELIVERY_JIRA_EMAIL=                           # Jira user email for basic auth
DELIVERY_JIRA_API_TOKEN=                       # Jira API token (email:token stored in vault)

# === External Agent Telemetry Plane V1 (default OFF) ===
# Aether observes telemetry from tenant-owned agents deployed on external
# surfaces (Discord, Telegram, Slack, web widgets, MCP servers, workers).
# No marketplace, no agent hosting, no execution.
AETHER_EXTERNAL_AGENT_TELEMETRY_ENABLED=false  # Master switch for external agent telemetry ingestion validation
KYBER_EXTERNAL_AGENT_TELEMETRY_ENABLED=false   # Kyber telemetry diagnostics surfaces
AETHER_AGENT_DEPLOYMENT_REGISTRY_ENABLED=false # Durable AgentDeployment registry + /v1/agent/deployments routes
AETHER_AGENT_TELEMETRY_SDK_ENABLED=false       # Accept AgentDeploymentContext from the server-side telemetry SDK
AETHER_AGENT_DEPLOYMENT_GRAPH_ENABLED=false    # Graph projections for deployments (deployment→agent/platform)
AETHER_AGENT_DEPLOYMENT_PROFILE360_ENABLED=false  # Profile360 external deployment activity subresource

# === Payment Rail Observability V1 (default OFF) ===
# Named providers only — no generic webhook fallback. Aether observes and
# reconciles; it never executes/settles payments or custodies funds.
# Provider credentials are tenant-scoped in the BYOK vault, never here.
AETHER_PAYMENT_RAILS_ENABLED=false             # Master switch: mounts /v1/integrations/providers/* payment routes
AETHER_PROVIDER_PRIVY_ENABLED=false            # Privy fiat onramp / bank deposits / crypto deposit addresses
AETHER_PROVIDER_STRIPE_ENABLED=false           # Stripe crypto onramp sessions (distinct from Aether billing Stripe)
AETHER_PROVIDER_COINBASE_ENABLED=false         # Coinbase onramp/offramp webhooks + transaction status polling
AETHER_PROVIDER_MOONPAY_ENABLED=false          # MoonPay buy/sell webhooks + status lookup
AETHER_PROVIDER_BRIDGE_ENABLED=false           # Bridge virtual accounts + activity polling
KYBER_PAYMENT_RAILS_ENABLED=false              # Kyber payment rails health surfaces

# === AI Outcome Efficiency / AI Economics (default OFF) ===
# Observes AI execution facts (no raw prompt/completion content), prices cost
# from effective-dated price cards, aggregates workflow economics, and
# generates governed efficiency recommendations (proposals only).
AETHER_AI_OUTCOME_EFFICIENCY_ENABLED=false     # Master switch: tenant AI Efficiency surfaces + /v1/economic/ai routes
AETHER_AI_EXECUTION_FACTS_ENABLED=false        # ai_invocation_observed → ai_execution_facts silver projection
AETHER_AI_ECONOMICS_ENABLED=false              # Pricing registry, cost selection hierarchy, workflow aggregation
AETHER_AI_EFFICIENCY_RECOMMENDATIONS_ENABLED=false  # ai_outcome_efficiency recommendation family detectors
KYBER_AI_EFFICIENCY_HEALTH_ENABLED=false       # Kyber AI Efficiency Health surfaces

# === Cluster Targeting Intelligence (default OFF) ===
# Observation-first: targeting intents, eligibility snapshots, leakage,
# holdouts, journey deltas, export packages, OODA suggestions.
# Aether does not execute campaigns.
AETHER_CLUSTER_TARGETING_INTELLIGENCE_ENABLED=false  # Master switch: /v1/targeting-intelligence routes + services
AETHER_TARGETING_EXPORTS_ENABLED=false         # Evidence-backed targeting export packages
AETHER_TARGETING_OODA_SUGGESTIONS_ENABLED=false  # Targeting suggestion generation into OODA suggestion feed
KYBER_TARGETING_INTELLIGENCE_ENABLED=false     # Kyber targeting fleet health / leakage queue / diagnostics

# === Aether/Kyber One-Person Operations (default OFF) ===
# Worker execution bridge, durable runtime, staged graph mutation
# review-to-commit, Catalyst/Cycle automation, Kyber agent command center.
# Human approval gates are never removed by these flags.
AETHER_AGENT_RUNTIME_DURABLE_ENABLED=false     # Require durable runtime stores in hosted modes (fail closed)
AETHER_AGENT_WORKER_BRIDGE_ENABLED=false       # Dispatch objective steps to Agent Layer workers via Celery
AETHER_STAGED_GRAPH_MUTATION_REVIEW_ENABLED=false  # Approval-to-commit pipeline for staged graph mutations
AETHER_CATALYST_CYCLE_AUTOMATION_ENABLED=false # Catalyst wake triggers + Cycle runtime automation
KYBER_AGENT_COMMAND_CENTER_ENABLED=false       # Kyber live agent command center surfaces
KYBER_ONE_PERSON_OPS_ENABLED=false             # One-person ops gates, alerts, briefings, readiness surfaces
# Worker bridge broker (backend → Agent Layer dispatch by task name). Falls
# back to CELERY_BROKER_URL, then REDIS_URL; hosted modes FAIL CLOSED when no
# broker is reachable. Agent Layer worker processes read AETHER_BACKEND_URL +
# AETHER_WORKER_TOKEN (service credential with agent:run_update) for status
# callbacks to POST /v1/agent/runs/{run_id}/status.
# AGENT_LAYER_BROKER_URL=redis://localhost:6379/0
