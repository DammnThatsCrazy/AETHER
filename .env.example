# =============================================================================
# Aether Platform — Environment Variables
#
# Copy to .env and customize for your environment:
#   cp .env.example .env
#
# All variables have sensible defaults for local development.
# Variables marked [REQUIRED IN PRODUCTION] must be set for non-local envs.
# =============================================================================

# === Frontend Apps (separate .env.example per app) ===
# apps/kyber/.env.example  — Kyber operator console (port 5174, VITE_KYBER_ENV)
# apps/aether/.env.example — Aether customer app   (port 5175, VITE_AETHER_ENV)

# === General ===
AETHER_ENV=local                       # local | dev | staging | production
DEBUG=true

# === Database — PostgreSQL (asyncpg) ===
# DATABASE_URL is the primary connection string used by repositories.
# Individual TSDB_* vars are kept for backward compatibility with deployment scripts.
DATABASE_URL=                            # [REQUIRED IN PRODUCTION] e.g. postgresql://aether:pass@db:5432/aether
TSDB_HOST=localhost
TSDB_PORT=5432
TSDB_DATABASE=aether
TSDB_USER=aether
TSDB_PASSWORD=                          # [REQUIRED IN PRODUCTION]
TSDB_POOL_MIN=5
TSDB_POOL_MAX=20

# === Database — Amazon Neptune (Graph) ===
# Neptune requires AWS infrastructure (VPC, IAM, cluster). When NEPTUNE_ENDPOINT
# is left as "localhost" in non-local environments, the backend will warn at
# startup and graph intelligence features (H2H/H2A/A2H/A2A) will be unavailable.
# Provision Neptune first, then set the cluster endpoint (e.g. <cluster>.cluster-xyz.us-east-1.neptune.amazonaws.com).
NEPTUNE_ENDPOINT=localhost               # [REQUIRED FOR GRAPH FEATURES]
NEPTUNE_PORT=8182
AWS_REGION=us-east-1

# === Cache — Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_SIZE=10

# === Database — DynamoDB ===
DYNAMODB_ENDPOINT=                      # Leave empty for AWS; set for local DynamoDB
DYNAMODB_TABLE_PREFIX=aether_

# === Database — OpenSearch ===
OPENSEARCH_ENDPOINT=localhost
OPENSEARCH_PORT=9200

# === Event Bus — Kafka / SNS+SQS ===
EVENT_BROKER=kafka                      # kafka | sns_sqs
KAFKA_BOOTSTRAP_SERVERS=localhost:9092   # [REQUIRED IN PRODUCTION] Used by aiokafka producer/consumer
KAFKA_BROKERS=localhost:9092            # Legacy alias
KAFKA_CONSUMER_GROUP=aether-backend
SNS_TOPIC_ARN=
SQS_QUEUE_URL=

# === API Configuration ===
CORS_ORIGINS=http://localhost:3000,https://app.aether.io
MAX_REQUEST_BODY_MB=10

# === Self-Serve Plans & Rate Limiting ===
# Active pricing strategy. Selects which subscription/overage rate sheet
# is used by the OverageCalculator at billing time. Validated A/B/C at
# startup.  A = Market Entry, B = Ideal/Fair, C = Premium.
PRICING_OPTION=B
# Days to retain Redis quota counters (rl:quota:* and rl:overage:*).
QUOTA_REDIS_TTL_DAYS=35
# Interval (seconds) for the background quota -> tenant_usage flusher.
QUOTA_FLUSH_INTERVAL_S=60

# === Authentication ===
JWT_SECRET=change-me-in-production      # [REQUIRED IN PRODUCTION] Generate: python scripts/generate_secrets.py
JWT_EXPIRY_MINUTES=60
ORACLE_SIGNER_PRIVATE_KEY=              # [REQUIRED IN PRODUCTION] secp256k1 key for oracle proofs. Generate: python scripts/generate_secrets.py

# === Intelligence Graph Feature Flags ===
IG_AGENT_LAYER=false
IG_COMMERCE_LAYER=false
IG_X402_LAYER=false
IG_ONCHAIN_LAYER=false
IG_TRUST_SCORING=false
IG_BYTECODE_RISK=false
IG_RPC_GATEWAY=false

# === QuickNode (Blockchain RPC) ===
QUICKNODE_API_KEY=
QUICKNODE_ENDPOINT=
QUICKNODE_X402_ENABLED=false
QUICKNODE_MAX_RPS=100

# === Provider Gateway ===
PROVIDER_GATEWAY_ENABLED=false
BYOK_ENCRYPTION_KEY=                    # [REQUIRED IN PRODUCTION] Fernet key for BYOK vault (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
PROVIDER_GATEWAY_ENCRYPTION_KEY=        # Legacy alias for BYOK_ENCRYPTION_KEY
# Durable payment-provider CredentialAuthority cipher. `local` = AES-256-GCM with
# a local key (dev/test only); `aws_kms` = KMS envelope encryption bound to a
# 5-key encryption context {tenant,provider,environment,slot,version}. Startup
# FAILS CLOSED outside local if CREDENTIAL_CIPHER != aws_kms or the key id is
# missing. See AWS Deployment/aether-aws/terraform/modules/kms_credentials.
CREDENTIAL_CIPHER=local                 # local | aws_kms  (aws_kms REQUIRED in staging/production)
CREDENTIAL_KMS_KEY_ID=                  # [REQUIRED when CREDENTIAL_CIPHER=aws_kms] KMS CMK id/arn
CREDENTIAL_ROTATION_OVERLAP_HOURS=24    # webhook-secret active+previous overlap window
ALCHEMY_API_KEY=
ALCHEMY_ENDPOINT=
INFURA_API_KEY=
INFURA_PROJECT_ID=
ETHERSCAN_API_KEY=
MORALIS_API_KEY=
PROVIDER_MAX_RETRIES=2
PROVIDER_CB_THRESHOLD=5
PROVIDER_CB_TIMEOUT_S=30
PROVIDER_METER_FLUSH_S=60

# === Model Extraction Defense ===
ENABLE_EXTRACTION_DEFENSE=false
ENABLE_OUTPUT_NOISE=true
ENABLE_WATERMARK=true
ENABLE_QUERY_ANALYSIS=true
WATERMARK_SECRET_KEY=aether-wm-default-change-me   # [REQUIRED IN PRODUCTION]
CANARY_SECRET_SEED=aether-canary-seed-change-me     # [REQUIRED IN PRODUCTION] Generate: python scripts/generate_secrets.py
EXTRACTION_KEY_RPM=60
EXTRACTION_KEY_RPH=1000
EXTRACTION_KEY_RPD=10000
EXTRACTION_IP_RPM=120
EXTRACTION_IP_RPH=3000
EXTRACTION_IP_RPD=30000
EXTRACTION_NOISE_STD=0.02
EXTRACTION_OUTPUT_PRECISION=2

# === Extraction Defense Mesh (distributed multi-identity layer) ===
ENABLE_EXTRACTION_MESH=false
EXTRACTION_BUDGET_ENABLED=true
EXTRACTION_EXPECTATION_ENABLED=true
EXTRACTION_POLICY_ENABLED=true
EXTRACTION_ATTRIBUTION_ENABLED=true
EXTRACTION_CANARY_SEED=aether-mesh-canary-seed       # [REQUIRED IN PRODUCTION] Generate: python scripts/generate_secrets.py
EXTRACTION_TELEMETRY_ENABLED=true
EXTRACTION_PRIVILEGED_TENANTS=                         # Comma-separated tenant IDs exempt from mesh
EXTRACTION_PRIVILEGED_API_KEYS=                        # Comma-separated API keys exempt from mesh
EXTRACTION_BATCH_INTERNAL_ONLY=true
EXTRACTION_ALERT_ON_ORANGE=true
EXTRACTION_ALERT_ON_RED=true

# === Stripe Billing ===
# Stripe-managed subscription billing for the AETHER P1-P4 plan catalog.
# When STRIPE_BILLING_ENABLED=true in non-local environments, the secret key,
# webhook secret, P1-P4 price IDs, and checkout/portal URLs are required.
# In AETHER_ENV=local, missing Stripe config is permitted: checkout/portal
# routes will return mocked URLs instead of failing.
# STRIPE_OVERAGE_PRICE_ID is OPTIONAL — required ONLY if charging AETHER
# overage usage through Stripe invoices. When unset, the existing AETHER
# overage calculation (shared/billing/overage.py) is used internally and no
# Stripe overage invoice can be created.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=                              # [REQUIRED IN PRODUCTION when STRIPE_BILLING_ENABLED]
STRIPE_WEBHOOK_SECRET=                          # [REQUIRED IN PRODUCTION when STRIPE_BILLING_ENABLED]
STRIPE_PRICE_P1=                                # Recurring subscription Price ID for P1 Hobbyist
STRIPE_PRICE_P2=                                # Recurring subscription Price ID for P2 Professional
STRIPE_PRICE_P3=                                # Recurring subscription Price ID for P3 Growth Intelligence
STRIPE_PRICE_P4=                                # Recurring subscription Price ID for P4 Protocol Master
STRIPE_OVERAGE_PRICE_ID=                        # OPTIONAL — Price ID for Stripe-charged overage line items
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing

# === Smart Contracts (EVM Chains) ===
# Set after deploying with: npx hardhat run scripts/deploy.js --network <network>
ANALYTICS_REWARDS_ADDRESS=               # AnalyticsRewards contract address
REWARD_REGISTRY_ADDRESS=                 # RewardRegistry contract address
REWARD_TOKEN_ADDRESS=                    # ERC-20 token used for reward payouts
DEPLOYER_KEY=                            # [KEEP OFFLINE] Deployer wallet private key
ORACLE_ADDRESS=                          # Oracle signer address (from generate_secrets.py)
# Block explorer API keys (for contract verification)
ETHERSCAN_KEY=
POLYGONSCAN_KEY=
ARBISCAN_KEY=
BASESCAN_KEY=
OPTIMISM_ETHERSCAN_KEY=
# EVM chain RPC overrides (optional — defaults to public RPCs)
ETHEREUM_RPC=
ETHEREUM_TESTNET_RPC=
POLYGON_RPC=
POLYGON_TESTNET_RPC=
ARBITRUM_RPC=
ARBITRUM_TESTNET_RPC=
BASE_RPC=
BASE_TESTNET_RPC=
OPTIMISM_RPC=
OPTIMISM_TESTNET_RPC=

# === GeoIP Enrichment (MaxMind GeoLite2) ===
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=/usr/share/GeoIP/GeoLite2-ASN.mmdb

# === Agent Layer ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_CONCURRENCY=8

# === ML Serving ===
ML_SERVING_URL=http://localhost:8080

# === Data Ingestion (Node.js) ===
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
BATCH_SIZE=500
MAX_EVENT_SIZE_KB=32

# === Social API Keys (Agent Workers) ===
TWITTER_BEARER_TOKEN=
DISCORD_BOT_TOKEN=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=

# === Market Data Providers ===
COINGECKO_API_KEY=                         # Optional — free tier works without key
BINANCE_API_KEY=                           # [REQUIRED for CEX data]
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# === Prediction Market Providers ===
POLYMARKET_API_KEY=                        # Optional — public API available
KALSHI_API_KEY=                            # [REQUIRED for Kalshi]
KALSHI_API_SECRET=

# === Web3 Social Providers ===
FARCASTER_API_KEY=                         # Neynar API key for Farcaster data
LENS_API_KEY=                              # Optional — Lens Protocol API token

# === Identity Enrichment ===
ENS_SUBGRAPH_URL=                          # Optional — custom ENS subgraph endpoint
GITHUB_PAT=                                # GitHub Personal Access Token

# === Governance ===
SNAPSHOT_GRAPHQL_URL=                      # Optional — custom Snapshot hub endpoint

# === On-Chain Intelligence (contract required) ===
CHAINALYSIS_API_KEY=                       # Chainalysis risk API (requires contract)
NANSEN_API_KEY=                            # Nansen wallet labels (requires contract)

# === TradFi Data (subscription required) ===
MASSIVE_API_KEY=                           # Massive alternative data (requires contract)
DATABENTO_API_KEY=                         # Databento market data (requires subscription)

# === Observability ===
GRAFANA_ADMIN_PASSWORD=admin               # [REQUIRED IN PRODUCTION] Generate: python scripts/generate_secrets.py

# === Data Lake / Iceberg ===
ICEBERG_CATALOG_URI=                       # Optional — REST catalog URI (e.g. http://nessie:19120/api/v1)
ICEBERG_S3_BUCKET=aether-snapshots-dev     # S3 bucket for Iceberg snapshot storage

# === Security & Governance (Kyber operator access) ===
# No Aether tenant may access Kyber. An operator is recognised ONLY by one of these.
KYBER_OPERATOR_PERMISSION=kyber:operator   # Permission that marks an Olympus operator (tenants never have it)
KYBER_OPERATOR_TENANT_IDS=                 # Comma-separated internal operator tenant IDs allowed on Kyber

# === Data Quality / Drift / Intelligence Quality ===
# All default off; routes mount only when enabled. No external services required.
AETHER_DATA_QUALITY_ENABLED=false              # Tenant /v1/data-quality/* routes
KYBER_INTELLIGENCE_QUALITY_ENABLED=false       # Kyber /v1/admin/kyber/intelligence-quality/* routes
AETHER_DATA_QUALITY_WATCH_THRESHOLD=0.8        # Quality score below this → "watch"/"degraded"
AETHER_DATA_QUALITY_CRITICAL_THRESHOLD=0.6     # Quality score below this → "critical"

# === Inbound data-provider / connector ingestion ===
# Master switch OFF by default; per-connector enablement is per-tenant config.
# Provider credentials are required only when a connector is enabled for a tenant.
AETHER_CONNECTORS_ENABLED=false                # Mounts /v1/integrations/connectors/*
KYBER_CONNECTOR_HEALTH_ENABLED=false           # Mounts /v1/admin/kyber/connectors/* (aggregate)

# === Universal Provider Runtime (plugin-based providers; additive to connectors) ===
# Master switch OFF by default; mounting in main.py is the only gate.
# All follow-on runtime controls default OFF (fail-closed).
AETHER_PROVIDER_RUNTIME_ENABLED=false              # Mounts /v1/provider-connections/* + provider webhooks
AETHER_PROVIDER_ENTRY_POINTS_ENABLED=false         # Package entry-point plugin discovery
KYBER_PROVIDER_RUNTIME_HEALTH_ENABLED=false        # Mounts /v1/admin/kyber/provider-connections/* (aggregate); OR-gate with the UI flag below
AETHER_PROVIDER_SYNC_SCHEDULER_ENABLED=false       # Background provider sync scheduler (pull loop)
AETHER_PROVIDER_SYNC_INTERVAL_SECONDS=3600         # Scheduler cadence (seconds); interval-driven only this build
AETHER_PROVIDER_SYNC_CRON=                         # RESERVED (unimplemented this build); a cron expression is ignored — the scheduler is interval-driven only
AETHER_PROVIDER_MIGRATIONS_ENABLED=false           # Provider runtime data migrations
AETHER_PROVIDER_LEGACY_DECOMMISSION=false          # Decommission legacy connector paths under the runtime
KYBER_PROVIDER_RUNTIME_UI_ENABLED=false            # Gates the Kyber provider-connections UI; also mounts /v1/admin/kyber/provider-connections/* (providers/certify/tenants are the UI's data) when EITHER this OR the health flag is set

# === Olympus-owned provider corpus + data lake (all off by default) ===
# Safety gates (provenance quarantine, data rights fail-closed) are always active.
# These flags gate route mounting and background jobs only.
AETHER_CONNECTOR_DATA_RIGHTS_ENABLED=false         # Mount /v1/integrations/data-rights routes
AETHER_CONNECTOR_BYOK_ENABLED=true                 # BYOK key vault routes (safe to enable; credential-only)
AETHER_CONNECTOR_ACTIONS_ENABLED=false             # Action/notifier connector delivery path
AETHER_CONNECTOR_OLYMPUS_PROVIDERS_ENABLED=false   # Olympus-owned provider connector registry
AETHER_PROVIDER_SOURCE_CATALOG_ENABLED=false       # Provider catalog API (tenant-facing, if ever)
KYBER_PROVIDER_SOURCE_CATALOG_ENABLED=false        # Mount /v1/admin/kyber/providers/* routes
AETHER_PROVIDER_SYNC_ENABLED=false                 # Background provider sync jobs
# Dune access modes (each gated separately; all require credentials)
AETHER_DUNE_DATASHARE_ENABLED=false                # Dune Datashare via Snowflake/BigQuery/Databricks
AETHER_DUNE_API_ENABLED=false                      # Dune API (parameterized SQL, requires DUNE_API_KEY)
AETHER_DUNE_SIM_ENABLED=false                      # Dune Sim/Echo (realtime wallet enrichment)
# Lake provenance and lineage
AETHER_PROVIDER_COST_PROFILES_ENABLED=false        # Cost profile tracking per provider
AETHER_PROVIDER_RATE_LIMIT_PROFILES_ENABLED=false  # Rate limit profile tracking per provider
AETHER_ENRICHMENT_LINEAGE_ENABLED=false            # Attach lineage_id to Gold / Profile360 / graph artifacts
AETHER_GRAPH_OF_GRAPHS_POLICY_ENABLED=false        # Graph-of-graphs data use policy enforcement
# Unique signal features (each requires external credentials — see UNIQUE_SIGNAL_FEATURES.md)
AETHER_UNIQUE_SIGNAL_FEATURES_ENABLED=false        # Enable unique cross-source signal computation
# Anti-distillation (score binning, honeypot, rapid-query detection)
AETHER_ANTI_DISTILLATION_ENABLED=false             # Enable intelligence API distillation protection
KYBER_ANTI_DISTILLATION_ENABLED=false              # Expose /v1/admin/kyber/intelligence/anti-distillation

# === External billing / payment provider readiness (behind flags) ===
# Defaults to internal-only; the internal billing/revops layer is unaffected when off.
# None of these are required for local dev unless provider sync is enabled.
AETHER_EXTERNAL_BILLING_ENABLED=false          # Master switch for the BillingProvider interface
AETHER_STRIPE_BILLING_ENABLED=false            # Activate the Stripe provider stub
KYBER_BILLING_PROVIDER_SYNC_ENABLED=false      # Expose provider-sync status in Kyber RevOps
BILLING_PROVIDER_MODE=internal_only            # internal_only | stripe | manual_invoice | enterprise_contract
STRIPE_PRODUCT_MAPPING_JSON=                   # Optional JSON: {"package_id": "prod_..."}
STRIPE_PRICE_MAPPING_JSON=                     # Optional JSON: {"P3": "price_...", "P3:recommendations": "price_..."}

# === OODA Suggestion Intelligence ===
# All off by default. Enable as each lifecycle phase is operationalised.
AETHER_SUGGESTIONS_ENABLED=false               # Master switch: mounts /v1/suggestions/* routes
AETHER_SUGGESTIONS_AUTODELIVERY_ENABLED=false  # Auto-deliver approved suggestions (no human gate)
AETHER_SUGGESTIONS_EXECUTION_ENABLED=false     # Allow suggestion execution (requires explicit opt-in)
AETHER_SUGGESTIONS_NOESIS_ENABLED=true         # Route suggestion intents through Noesis read-only handler
AETHER_SUGGESTIONS_RECOMMENDATION_ADAPTER_ENABLED=true   # Wire legacy recommendations → suggestions
AETHER_SUGGESTIONS_NOTIFICATION_ADAPTER_ENABLED=true     # Wire notification intelligence → suggestions
AETHER_SUGGESTIONS_DATA_QUALITY_ADAPTER_ENABLED=true     # Wire data quality drift events → suggestions
AETHER_SUGGESTIONS_SDK_HEALTH_ADAPTER_ENABLED=true       # Wire SDK silence/failure events → suggestions
AETHER_SUGGESTIONS_GRAPH_ADAPTER_ENABLED=true            # Wire graph events → suggestions
KYBER_SUGGESTIONS_ENABLED=true                 # Mount /v1/admin/kyber/suggestions/* operator routes
AETHER_TENANT_SUGGESTIONS_ENABLED=true         # Mount /v1/aether/suggestions/* tenant-safe routes

# === Tenant activation + Kyber missions (flag-gated OFF; mounting is a no-op) ===
AETHER_ACTIVATION_ENABLED=false                # Mount /v1/activation routes (tenant activation state)
AETHER_COMMAND_CENTER_ENABLED=false            # Mount /v1/command-center route (read-only tenant aggregator)
KYBER_MISSIONS_ENABLED=false                   # Mount /v1/kyber mission control-plane routes
KYBER_MISSION_MONITORING_ENABLED=false         # Enable periodic MonitoringService.check_due loop

# === Partner ecosystem / marketplace / developer platform (FUTURE-FLAGGED ONLY) ===
# Intentionally NOT implemented in this pass. These flags default off and gate nothing yet.
AETHER_PARTNER_ECOSYSTEM_ENABLED=false
AETHER_MARKETPLACE_ENABLED=false
AETHER_DEVELOPER_PLATFORM_ENABLED=false
KYBER_PARTNER_ECOSYSTEM_ENABLED=false

# === Delivery Worker — durable provider dispatch + outcome tracking ===
# The DeliveryWorker polls delivery_jobs and dispatches via ProviderAdapters.
# Provider credentials are stored in the vault (ProvidersRepository), never here.
AETHER_DELIVERY_WORKER_ENABLED=true            # Enable the background delivery worker
DELIVERY_WORKER_BATCH_SIZE=10                  # Jobs claimed per poll cycle
DELIVERY_WORKER_LEASE_SECONDS=120              # Lease expiry window (seconds)
DELIVERY_WORKER_POLL_INTERVAL_S=5              # Poll interval when queue is empty
DELIVERY_WORKER_MAX_ATTEMPTS=5                 # Max dispatch attempts before dead-letter

# Slack (system-level default; per-tenant configured in UserNotificationChannel)
DELIVERY_SLACK_BOT_TOKEN=                      # xoxb-... Bot token for system-level Slack delivery
DELIVERY_SLACK_DEFAULT_CHANNEL=#aether-notifications

# Outbound webhook signing (used for X-Aether-Signature header)
DELIVERY_WEBHOOK_SIGNING_SECRET=               # HMAC-SHA256 signing secret for outbound webhooks

# Linear (system-level default API key; per-tenant keys stored in vault)
DELIVERY_LINEAR_API_KEY=                       # Linear API key for issue creation

# Jira (system-level default; per-tenant configured in connector config)
DELIVERY_JIRA_BASE_URL=                        # e.g. https://mycompany.atlassian.net
DELIVERY_JIRA_EMAIL=                           # Jira user email for basic auth
DELIVERY_JIRA_API_TOKEN=                       # Jira API token (email:token stored in vault)

# === External Agent Telemetry Plane V1 (default OFF) ===
# Aether observes telemetry from tenant-owned agents deployed on external
# surfaces (Discord, Telegram, Slack, web widgets, MCP servers, workers).
# No marketplace, no agent hosting, no execution.
AETHER_EXTERNAL_AGENT_TELEMETRY_ENABLED=false  # Master switch for external agent telemetry ingestion validation
KYBER_EXTERNAL_AGENT_TELEMETRY_ENABLED=false   # Kyber telemetry diagnostics surfaces
AETHER_AGENT_DEPLOYMENT_REGISTRY_ENABLED=false # Durable AgentDeployment registry + /v1/agent/deployments routes
AETHER_AGENT_TELEMETRY_SDK_ENABLED=false       # Accept AgentDeploymentContext from the server-side telemetry SDK
AETHER_AGENT_DEPLOYMENT_GRAPH_ENABLED=false    # Graph projections for deployments (deployment→agent/platform)
AETHER_AGENT_DEPLOYMENT_PROFILE360_ENABLED=false  # Profile360 external deployment activity subresource

# === Payment Rail Observability V1 (default OFF) ===
# Named providers only — no generic webhook fallback. Aether observes and
# reconciles; it never executes/settles payments or custodies funds.
# Provider credentials are provisioned per-tenant through the durable
# CredentialAuthority (multi-slot, KMS-encrypted, rotatable) — never in this file.
# Outside local development the CredentialAuthority is the SOLE credential source
# for payment providers (the legacy in-memory BYOK vault is retired for them).
AETHER_PAYMENT_RAILS_ENABLED=false             # Master switch: mounts /v1/integrations/providers/* payment routes
AETHER_PROVIDER_PRIVY_ENABLED=false            # Privy fiat onramp / bank deposits / crypto deposit addresses
AETHER_PROVIDER_STRIPE_ENABLED=false           # Stripe crypto onramp sessions (distinct from Aether billing Stripe)
AETHER_PROVIDER_COINBASE_ENABLED=false         # Coinbase onramp/offramp webhooks + transaction status polling
AETHER_PROVIDER_MOONPAY_ENABLED=false          # MoonPay buy/sell webhooks + status lookup
AETHER_PROVIDER_BRIDGE_ENABLED=false           # Bridge virtual accounts + activity polling
KYBER_PAYMENT_RAILS_ENABLED=false              # Kyber payment rails health surfaces
# Payment-rail delivery-integrity flags. credential_authority + canonical_repair
# default ON outside local (mandatory); the values below are the LOCAL defaults.
# Enable the canonical outbox + relay TOGETHER (an enabled outbox with a disabled
# relay strands events); staging/production release profiles must set all three.
AETHER_PAYMENT_CREDENTIAL_AUTHORITY_ENABLED=false  # Default ON outside local (durable authority mandatory)
AETHER_PAYMENT_CANONICAL_OUTBOX_ENABLED=false      # Write payment canonical events to the durable Bronze+outbox spine
AETHER_PAYMENT_CANONICAL_REPAIR_ENABLED=false      # Supervised canonical-repair worker (default ON outside local)
AETHER_PAYMENT_USAGE_METERING_ENABLED=false        # Bill one unit per newly accepted canonical event (keep OFF until contract confirmed)
AETHER_PAYMENT_LEGACY_WEBHOOK_ROUTE_ENABLED=false  # Local-dev-only header-tenant webhook route (404 outside local)
OUTBOX_RELAY_ENABLED=false                         # Ingestion V2 event-outbox relay (enable WITH the payment canonical outbox)
AETHER_INGESTION_REPLAY_ENABLED=false              # Ingestion-level replay (WS-B4): dry-run always allowed; real runs 403 until ON
AETHER_PAYMENT_TENANT_SYNC_RATE_LIMIT_PER_MINUTE=20    # Per-tenant budget for manual provider sync (0 disables)
AETHER_PAYMENT_TENANT_REPAIR_RATE_LIMIT_PER_MINUTE=10  # Per-tenant budget for manual canonical repair (0 disables)
# Payment-rail derived-condition alerting. Prometheus rules in
# deploy/observability/prometheus/alert_rules.yml fire on their own; the derived
# conditions with no single-series PromQL form (reconciliation-conflict backlog,
# backlog growth, outbox stalling, provider silence) are classified by an
# in-process evaluator that ONLY runs when the worker below is enabled. All
# thresholds are non-secret (seconds or counts) and per-environment tunable.
AETHER_PAYMENT_ALERT_EVAL_ENABLED=false                       # Run the derived-condition alert evaluator worker (default OFF; enable in staging/prod once the plane is live)
AETHER_PAYMENT_ALERT_EVAL_INTERVAL_SECONDS=300                # Evaluator cadence (seconds)
AETHER_PAYMENT_ALERT_NO_WEBHOOK_SECONDS=86400                 # Webhook-capable provider silent this long → alert (UNKNOWN, not 0, if never any webhook)
AETHER_PAYMENT_ALERT_OLDEST_RECEIPT_WARN_SECONDS=900          # Oldest incomplete receipt age → warn
AETHER_PAYMENT_ALERT_OLDEST_RECEIPT_CRITICAL_SECONDS=3600     # …→ critical
AETHER_PAYMENT_ALERT_CANONICAL_BACKLOG_WARN=50                # Incomplete-receipt backlog → warn
AETHER_PAYMENT_ALERT_CANONICAL_BACKLOG_CRITICAL=200           # …→ critical
AETHER_PAYMENT_ALERT_DEAD_LETTER_WARN=1                       # Dead-lettered deliveries → warn (any dead-letter warns)
AETHER_PAYMENT_ALERT_DEAD_LETTER_CRITICAL=10                  # …→ critical
AETHER_PAYMENT_ALERT_RECONCILIATION_CONFLICT_WARN=1           # Unresolved SDK-vs-provider conflicts → warn
AETHER_PAYMENT_ALERT_RECONCILIATION_CONFLICT_CRITICAL=25      # …→ critical
AETHER_PAYMENT_ALERT_RECONCILIATION_STALE_WARN=25             # Sessions past the reconciliation window → warn
AETHER_PAYMENT_ALERT_WEBHOOK_VERIFICATION_WINDOW_SECONDS=300  # Window for repeated signature-verification failures
AETHER_PAYMENT_ALERT_WEBHOOK_VERIFICATION_FAILURE_WARN=5      # …failures in window → warn
AETHER_PAYMENT_ALERT_WEBHOOK_VERIFICATION_FAILURE_CRITICAL=25 # …→ critical

# === Card-Linked Payment Rail Observability V1 (default OFF) ===
# Card-linked (crypto-card) economic observability nested under payment
# rails. Aether observes/normalizes/attributes only — it never processes
# card payments, issues cards, custodies funds, stores PAN/CVV/KYC/bank
# data, or makes automated fraud/credit/reward decisions. Top-up != spend;
# PaymentScan benchmarks are never user-level truth.
AETHER_CARD_LINKED_PAYMENT_RAILS_ENABLED=false # Master switch: /v1/integrations/providers/payment-rails/card-linked routes
AETHER_PAYMENTSCAN_CATALOG_ENABLED=false       # PaymentScan program/issuer/network catalog surface
AETHER_PAYMENTSCAN_BENCHMARKS_ENABLED=false    # PaymentScan benchmark ingestion + tenant benchmarks endpoint
AETHER_CARD_LINKED_PROFILE360_ENABLED=false    # Profile360 → Economic Activity → Payment Rails → Card-linked Activity
AETHER_CARD_LINKED_CAMPAIGN_ATTRIBUTION_ENABLED=false  # Campaign360 card-linked outcomes (attribution-basis labeled)
AETHER_CARD_LINKED_CLUSTERING_ENABLED=false    # Review-only card-linked cluster cohorts (never enforcement)
KYBER_CARD_LINKED_PAYMENT_RAILS_ENABLED=false  # Kyber card-linked diagnostics / clusters / release-gate surfaces
AETHER_CARD_LINKED_EU_RESTRICTED_MODE=true     # Safety default ON: EU/UK user-level card activity stripped
AETHER_CARD_LINKED_APAC_RESTRICTED_MODE=true   # Safety default ON: APAC user-level card activity stripped
AETHER_CARD_LINKED_PROVIDER_PII_BLOCK=true     # Safety default ON: blocked-PII fields rejected at ingestion

# === AI Outcome Efficiency / AI Economics (default OFF) ===
# Observes AI execution facts (no raw prompt/completion content), prices cost
# from effective-dated price cards, aggregates workflow economics, and
# generates governed efficiency recommendations (proposals only).
AETHER_AI_OUTCOME_EFFICIENCY_ENABLED=false     # Master switch: tenant AI Efficiency surfaces + /v1/economic/ai routes
AETHER_AI_EXECUTION_FACTS_ENABLED=false        # ai_invocation_observed → ai_execution_facts silver projection
AETHER_AI_ECONOMICS_ENABLED=false              # Pricing registry, cost selection hierarchy, workflow aggregation
AETHER_AI_EFFICIENCY_RECOMMENDATIONS_ENABLED=false  # ai_outcome_efficiency recommendation family detectors
KYBER_AI_EFFICIENCY_HEALTH_ENABLED=false       # Kyber AI Efficiency Health surfaces

# === Cluster Targeting Intelligence (default OFF) ===
# Observation-first: targeting intents, eligibility snapshots, leakage,
# holdouts, journey deltas, export packages, OODA suggestions.
# Aether does not execute campaigns.
AETHER_CLUSTER_TARGETING_INTELLIGENCE_ENABLED=false  # Master switch: /v1/targeting-intelligence routes + services
AETHER_TARGETING_EXPORTS_ENABLED=false         # Evidence-backed targeting export packages
AETHER_TARGETING_OODA_SUGGESTIONS_ENABLED=false  # Targeting suggestion generation into OODA suggestion feed
KYBER_TARGETING_INTELLIGENCE_ENABLED=false     # Kyber targeting fleet health / leakage queue / diagnostics

# === Aether/Kyber One-Person Operations (default OFF) ===
# Worker execution bridge, durable runtime, staged graph mutation
# review-to-commit, Catalyst/Cycle automation, Kyber agent command center.
# Human approval gates are never removed by these flags.
AETHER_AGENT_RUNTIME_DURABLE_ENABLED=false     # Require durable runtime stores in hosted modes (fail closed)
AETHER_AGENT_WORKER_BRIDGE_ENABLED=false       # Dispatch objective steps to Agent Layer workers via Celery
AETHER_STAGED_GRAPH_MUTATION_REVIEW_ENABLED=false  # Approval-to-commit pipeline for staged graph mutations
AETHER_CATALYST_CYCLE_AUTOMATION_ENABLED=false # Catalyst wake triggers + Cycle runtime automation
KYBER_AGENT_COMMAND_CENTER_ENABLED=false       # Kyber live agent command center surfaces
KYBER_ONE_PERSON_OPS_ENABLED=false             # One-person ops gates, alerts, briefings, readiness surfaces
# Worker bridge broker (backend → Agent Layer dispatch by task name). Falls
# back to CELERY_BROKER_URL, then REDIS_URL; hosted modes FAIL CLOSED when no
# broker is reachable. Agent Layer worker processes read AETHER_BACKEND_URL +
# AETHER_WORKER_TOKEN (service credential with agent:run_update) for status
# callbacks to POST /v1/agent/runs/{run_id}/status.
# AGENT_LAYER_BROKER_URL=redis://localhost:6379/0
# ─────────────────────────────────────────────────────────────────────────────
# Stablecoin Intelligence (observation-only; all default false / fail-closed)
# ─────────────────────────────────────────────────────────────────────────────
AETHER_STABLECOIN_INGESTION_ENABLED=false      # Stablecoin observation intake + normalization
AETHER_STABLECOIN_VALUATION_ENABLED=false      # Peg valuation snapshots + depeg detection
AETHER_STABLECOIN_FLOWS_ENABLED=false          # Windowed flow aggregates + gold materialization
AETHER_STABLECOIN_GRAPH_ENABLED=false          # Graph projection of stablecoin vertices/edges
AETHER_STABLECOIN_PROFILE360_ENABLED=false     # Profile360 stablecoin sub-resource
AETHER_STABLECOIN_API_ENABLED=false            # /v1/stablecoins tenant API router
AETHER_STABLECOIN_NOESIS_ENABLED=false         # Noesis stablecoin insight adapter
KYBER_STABLECOIN_OPS_ENABLED=false             # /v1/admin/kyber/stablecoins operator router

# ─────────────────────────────────────────────────────────────────────────────
# Derivatives Intelligence (observation-only; no execution capability exists)
# ─────────────────────────────────────────────────────────────────────────────
AETHER_DERIVATIVES_RUNTIME_ENABLED=false       # Registries, repos, state machines
AETHER_DERIVATIVES_ADAPTERS_ENABLED=false      # Read-only venue adapter framework
AETHER_DERIVATIVES_STREAMS_ENABLED=false       # Bounded market-stream lane (sequence/gap tracking)
AETHER_DERIVATIVES_RECONCILIATION_ENABLED=false # Snapshot-vs-projection reconciliation
AETHER_DERIVATIVES_PNL_ENABLED=false           # Decimal-safe P&L / exposure aggregation
AETHER_DERIVATIVES_GRAPH_ENABLED=false         # Graph projection of derivatives vertices/edges
AETHER_DERIVATIVES_PROFILE360_ENABLED=false    # Profile360 derivatives sub-resource
AETHER_DERIVATIVES_API_ENABLED=false           # /v1/derivatives tenant API router
AETHER_DERIVATIVES_NOESIS_ENABLED=false        # Noesis derivatives insight adapter
KYBER_DERIVATIVES_OPS_ENABLED=false            # /v1/admin/kyber/derivatives operator router

# ─────────────────────────────────────────────────────────────────────────────
# Interoperability Intelligence (observation-only; Aether never relays/routes)
# ─────────────────────────────────────────────────────────────────────────────
AETHER_INTEROP_INGESTION_ENABLED=false         # Interop observation intake
AETHER_INTEROP_LIFECYCLE_ENABLED=false         # Canonical message lifecycle engine
AETHER_INTEROP_ADAPTERS_ENABLED=false          # Provider adapter framework
AETHER_INTEROP_LAYERZERO_ENABLED=false         # LayerZero V2 reference adapter (requires ADAPTERS)
AETHER_INTEROP_GRAPH_ENABLED=false             # Graph projection of interop vertices/edges
AETHER_INTEROP_PROFILE360_ENABLED=false        # Profile360 interoperability sub-resource
AETHER_INTEROP_API_ENABLED=false               # /v1/interoperability tenant API router
AETHER_INTEROP_NOESIS_ENABLED=false            # Noesis interop insight adapter
KYBER_INTEROP_OPS_ENABLED=false                # /v1/admin/kyber/interop operator router

# --- Unified Intelligence Plane (all capability flags default OFF; safety flags default ON) ---
AETHER_TEMPORAL_ENFORCEMENT_MODE=off           # Strict-ingestion ladder: off | shadow | warn | enforce
AETHER_TEMPORAL_CANARY_TENANTS=                # Comma-separated tenant ids that get the configured mode (empty = all when mode != off)
AETHER_VIEWER_TIMEZONE_ENABLED=false           # Viewer temporal preferences API + shared frontend time provider
AETHER_PRODUCT_INTELLIGENCE_ENABLED=false      # Product & Experience Intelligence plane
AETHER_PRODUCT_CATALOG_ENABLED=false           # /v1/product-catalog tenant API router
AETHER_CONTEXT_ENRICHMENT_ENABLED=false        # Server-derived network/geo context on /v1/batch (shadow first)
AETHER_NORMALIZATION_SPINE_ENABLED=false       # WS-B5: consumers read validated payloads via one spine (flat legacy when OFF)
AETHER_INGESTION_OBSERVABILITY_ENABLED=false   # WS-E: ingestion funnel telemetry + Kyber Observation Inspector / control plane (OFF = no recording)
AETHER_SDK_VERSION_COMPAT_ENABLED=false        # WS-E (Invariant #18): consult context.library.version + advisory sdk_tier label on /v1/batch
AETHER_SDK_VERSION_COMPAT_MODE=off             # WS-E: version-compat ladder off | shadow | warn | enforce (enforce rejects past blocked-after date)
AETHER_CONTEXT_CAPSULES_ENABLED=false          # Context Capsule lifecycle processing
AETHER_RAW_IP_PERSISTENCE_BLOCKED=true         # SAFETY (default ON): raw IPs never persist; HMAC only
AETHER_LOCATION_IDENTITY_MERGE_BLOCKED=true    # SAFETY (default ON): context/behavior never merges identities alone
AETHER_TRUSTED_PROXY_CIDRS=                    # Comma-separated CIDRs whose X-Forwarded-For hops are trusted
AETHER_CLOUDFLARE_PROXY_ENABLED=false          # Honor CF-Connecting-IP only from verified Cloudflare ranges
AETHER_IP_HMAC_ROTATION_HOURS=24               # Tenant-scoped IP HMAC key rotation window
AETHER_TEMPORAL_OBSERVATORY_ENABLED=false      # Bitemporal reconstruction plane (/v1/temporal)
# --- Deprecated ingest aliases (WS-B2): POST /v1/ingest/events and
#     /v1/ingest/events/batch are converged onto the canonical /v1/batch spine
#     (validation / consent / scrub / Bronze-durable / idempotency / publish)
#     and stay mounted so gateway discovery sees them. Turn ON to retire both
#     with HTTP 410 and force SDKs onto POST /v1/batch. ---
AETHER_KILL_DEPRECATED_INGEST_ALIASES=false
AETHER_MUTATION_GATEWAY_MODE=off               # Graph mutation gateway ladder: off | shadow | enforce
AETHER_EXPLORATION_ENABLED=false               # Unified Exploration Fabric (/v1/explore)
AETHER_COMPARISON_INTELLIGENCE_ENABLED=false   # Comparison/decision intelligence (/v1/intelligence/comparisons)

# ---------------------------------------------------------------------------
# Kyber workforce identity (Olympus operator plane)
#
# An Olympus operator is NOT an Aether tenant. A production Kyber session
# requires an invite-created workforce principal, a valid Google Workspace
# identity, an approved personal device (WebAuthn credential + browser-bound
# device-proof key + server-issued grant), and a backend-authorized role.
#
# In staging and production, Settings() REFUSES TO START when the workforce
# plane is enabled and the SSO / WebAuthn anchors below are unset, or when any
# of the enforcement flags is disabled, or when bootstrap is left on.
# ---------------------------------------------------------------------------
KYBER_WORKFORCE_IDENTITY_ENABLED=false   # Workforce principals are the production identity
KYBER_DEVICE_TRUST_REQUIRED=false        # Require an approved device for operator authority
KYBER_BACKEND_AUTHZ_ENFORCED=false       # Enforce declared route capabilities at the boundary
KYBER_SCOPE_V2_ENABLED=true                    # Durable, purpose-bound tenant access scopes
KYBER_STEP_UP_REQUIRED=false             # Fresh WebAuthn assertion for high-risk actions
KYBER_LEGACY_OPERATOR_IDENTITY_ALLOWED=true  # Legacy tenant-permission operator path; MUST be false in staging/production
KYBER_SESSION_COOKIE_SECURE=false        # Secure attribute on __Host-kyber_session

# Google Workspace OIDC. The code exchange happens server-side; no token is ever
# exposed to frontend JavaScript.
KYBER_GOOGLE_CLIENT_ID=
KYBER_GOOGLE_CLIENT_SECRET=
KYBER_GOOGLE_REDIRECT_URI=http://localhost:8000/v1/kyber/auth/callback
KYBER_GOOGLE_HOSTED_DOMAIN=              # When set, the `hd` claim must match
KYBER_GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# WebAuthn relying party. RP id and origin must match the Kyber frontend origin.
KYBER_WEBAUTHN_RP_ID=localhost
KYBER_WEBAUTHN_RP_NAME=Kyber
KYBER_WEBAUTHN_ORIGIN=http://localhost:3000

# Origins permitted to make mutating Kyber requests (CSRF/origin gate).
KYBER_ALLOWED_ORIGINS=http://localhost:3000

# One-time founder bootstrap. Refuses to run while ANY workforce principal
# exists, and Settings() refuses staging/production while it is true.
KYBER_BOOTSTRAP_ENABLED=false
KYBER_BOOTSTRAP_FOUNDER_EMAIL=
KYBER_BOOTSTRAP_FOUNDER_GOOGLE_SUBJECT=

# Google Admin SDK reconciliation. When disabled, Kyber cannot learn that a
# Google account was suspended — manual Kyber suspension is then the
# authoritative immediate control. See docs/runbooks/KYBER_WORKFORCE_OFFBOARDING.md
KYBER_DIRECTORY_SYNC_ENABLED=false
KYBER_GOOGLE_ADMIN_ACCESS_TOKEN=
KYBER_DIRECTORY_SYNC_REQUIRED=false   # Deny privileged access when directory state is unverifiable
KYBER_DIRECTORY_MAX_STALE_HOURS=24
KYBER_DIRECTORY_SYNC_INTERVAL_SECONDS=3600

# =============================================================================
# Communications Intelligence — connectors, credentials, feature flags
# =============================================================================
# Deploy-before-credentials: with no provider credential the app starts,
# providers report `credential_missing`, and no provider API call is attempted.
# Supplying a credential later activates the provider with NO code change.

# Feature flags / kill switches (config/settings.py::CommsConfig). All default
# on except where noted; flip to false to disable a stage without a redeploy.
AETHER_COMMS_INGESTION_ENABLED=true
AETHER_COMMS_CAMPAIGN_PROJECTION_ENABLED=true
AETHER_COMMS_JOURNEYS_ENABLED=true
AETHER_COMMS_GRAPH_ENABLED=true
AETHER_COMMS_PROFILE360_ENABLED=true
AETHER_COMMS_CAMPAIGN360_ENABLED=true
# Provider suppression write-back is a SEPARATELY-AUTHORIZED capability. OFF by
# default (observe-only, ADR-C1): read access never implies suppression-write.
AETHER_COMMS_SUPPRESSION_WRITE_BACK=false

# WS-B3 consent-on-every-path (shared ingress facade in
# services/ingestion/validation.py + config/settings.py::IngressConsentConfig).
# Each non-batch ingress seam (feed, connector-comm, payment-rails webhook,
# provider-runtime, tenant import commit) runs the SAME machinery as /v1/batch.
# The MANDATORY minimization layer -- scrub + strip + T-class tenant data-policy
# -- is UNCONDITIONAL on every path (default ON, NOT gated by these flags): a
# pure convergence win (scrub never rejects; data-policy is default-allow). Each
# flag below enables ONLY the per-subject (S) server-receipt rejection for that
# path, which is additionally gated on AUTHORITATIVE_CONSENT_ENFORCEMENT_ENABLED
# (stage/prod ON, local OFF); disabling the T-class import flag DENIES commits
# (fail closed) rather than bypassing the policy layer.
FEED_INGRESS_CONSENT_ENFORCEMENT_ENABLED=true
CONNECTOR_COMMS_CONSENT_ENFORCEMENT_ENABLED=true
PAYMENT_RAILS_INGRESS_SCRUB_ENABLED=true
PROVIDER_RUNTIME_CONSENT_ENFORCEMENT_ENABLED=true
IMPORTS_CONSENT_POLICY_ENABLED=true

# Credential platform backend (shared/credentials). local_encrypted (default,
# Fernet over Postgres) | aws_secrets_manager (lazy boto3) | in_memory (tests).
AETHER_CREDENTIAL_BACKEND=local_encrypted
# AWS Secrets Manager prefix. Per-tenant provider credentials are stored at
# `${AETHER_CREDENTIAL_AWS_PREFIX}/{tenant_id}/connector:{tenant_id}:{provider}`,
# e.g. aether/credentials/<tenant>/connector:<tenant>:klaviyo — NEVER commit a
# real secret; the value lives only in the secret manager / encrypted store.
AETHER_CREDENTIAL_AWS_PREFIX=aether/credentials

# Klaviyo (certified reference communications adapter). The API key is stored
# per-tenant via the credential platform (reference above); there is NO global
# Klaviyo key env var — customer credentials are tenant-scoped by design.

# === Model Runtime — Multi-Model Intelligence Harness (ADR-008) ===
# The model runtime (services/model_runtime) reads MODEL_RUNTIME_* variables to
# select providers, resolve credentials, and guard provider health. The authoritative
# parse lives in services/model_runtime/config.py.
#
# Staging/production FAIL CLOSED: missing required configuration, or an unresolvable
# credential backend, causes the runtime to refuse to serve and to log an explicit
# startup error rather than falling back to an insecure default.
# Credentials are NEVER stored here — only variable names and empty/neutral
# placeholders. Key rotation is handled entirely by the secret backend
# (env-injected at deploy time, or AWS Secrets Manager), never by editing this file.
MODEL_RUNTIME_ENABLED=false                                    # feature gate; keep OFF by default (ADR-008 D9)
MODEL_RUNTIME_DEFAULT_PROVIDER=deterministic                   # production MUST NOT be deterministic
MODEL_RUNTIME_ESTIMATED_REQUEST_TOKENS=800                     # per-request token budget used by routing
MODEL_RUNTIME_MAX_PROVIDERS=16                                 # maximum providers considered per routing decision
MODEL_RUNTIME_CREDENTIAL_BACKEND=in_memory                     # [REQUIRED IN PRODUCTION] must be `env` or `aws_secrets`
MODEL_RUNTIME_CREDENTIAL_AWS_REGION=                           # [REQUIRED IN PRODUCTION] when backend=aws_secrets
MODEL_RUNTIME_CREDENTIAL_AWS_PREFIX=aether/credentials         # Secrets Manager prefix for provider credentials
MODEL_RUNTIME_CREDENTIAL_CACHE_TTL_SECONDS=60                  # credential resolution cache TTL
MODEL_RUNTIME_OBSERVABILITY_ENABLED=false                      # metrics/circuit telemetry; keep OFF locally
MODEL_RUNTIME_CIRCUIT_FAILURE_THRESHOLD=5                      # consecutive failures before a provider trips
MODEL_RUNTIME_CIRCUIT_RECOVERY_TIMEOUT_S=60                    # seconds before a tripped provider retries
MODEL_RUNTIME_ADAPTERS_DIR=services/model_runtime/adapters     # provider adapter registry directory
