{
  "uid": "aether-extraction-defense",
  "title": "Extraction Defense",
  "tags": ["aether", "security", "extraction"],
  "schemaVersion": 36,
  "version": 1,
  "timezone": "utc",
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource"
      },
      {
        "name": "tenant_id",
        "type": "query",
        "label": "Tenant",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "definition": "label_values(extraction_risk_band_total, tenant_id)",
        "query": "label_values(extraction_risk_band_total, tenant_id)",
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Risk Band Distribution",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "sum(rate(extraction_risk_band_total{band=\"green\"}[5m]))", "legendFormat": "Green (safe)"},
        {"expr": "sum(rate(extraction_risk_band_total{band=\"yellow\"}[5m]))", "legendFormat": "Yellow (watch)"},
        {"expr": "sum(rate(extraction_risk_band_total{band=\"orange\"}[5m]))", "legendFormat": "Orange (elevated)"},
        {"expr": "sum(rate(extraction_risk_band_total{band=\"red\"}[5m]))", "legendFormat": "Red (critical)"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Green (safe)"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Yellow (watch)"}, "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Orange (elevated)"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Red (critical)"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}
        ]
      }
    },
    {
      "id": 2,
      "title": "Blocked Requests per Hour",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (reason) (increase(extraction_blocked_total[1h]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 3,
      "title": "Watermark Hits",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(extraction_watermark_detected_total[5m]))",
          "legendFormat": "{{tenant_id}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 4,
      "title": "Canary Detections",
      "type": "stat",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum(increase(extraction_canary_detected_total[1h]))",
          "legendFormat": "Canary Hits (1h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Extraction Budget Utilization by Tenant",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "topk(10, extraction_budget_used_ratio{tenant_id=~\"$tenant_id\"} * 100)",
          "legendFormat": "{{tenant_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "orange", "value": 85},
              {"color": "red", "value": 95}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "High-Risk Events Table",
      "type": "table",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "topk(20, sum by (tenant_id) (increase(extraction_risk_band_total{band=~\"orange|red\"}[1h])))",
          "legendFormat": "{{tenant_id}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Value"}, "properties": [{"id": "displayName", "value": "High-Risk Events (1h)"}]}
        ]
      }
    }
  ]
}
