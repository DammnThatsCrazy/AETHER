# === Model Runtime — local deployment (copy to .env) ===
# Fail-closed: the model runtime service validates this configuration and
# raises ConfigError on misconfiguration. Placeholders only — NEVER commit real
# secrets here. Key rotation is handled by the credential backend
# (env | aws_secrets), not by editing this file.

# Enable the model runtime harness inside the aether-backend service.
MODEL_RUNTIME_ENABLED=false

# Adapter implementations directory (package path or filesystem dir).
MODEL_RUNTIME_ADAPTERS_DIR=

# Default provider used when no provider is explicitly routed.
# DO NOT use deterministic in staging/production.
MODEL_RUNTIME_DEFAULT_PROVIDER=deterministic

# Estimated request tokens used for budget pre-reservation.
MODEL_RUNTIME_ESTIMATED_REQUEST_TOKENS=800

# Maximum number of providers the routing layer may consider.
MODEL_RUNTIME_MAX_PROVIDERS=16

# Credential backend for provider secrets.
# production: env|aws_secrets
MODEL_RUNTIME_CREDENTIAL_BACKEND=in_memory

# AWS region for the aws_secrets credential backend (required when
# MODEL_RUNTIME_CREDENTIAL_BACKEND=aws_secrets).
MODEL_RUNTIME_CREDENTIAL_AWS_REGION=

# Secrets Manager prefix under which provider credentials are stored.
MODEL_RUNTIME_CREDENTIAL_AWS_PREFIX=aether/credentials

# Cache TTL (seconds) for resolved provider credentials.
MODEL_RUNTIME_CREDENTIAL_CACHE_TTL_SECONDS=60

# Enable runtime observability (metrics / circuit-breaker events).
MODEL_RUNTIME_OBSERVABILITY_ENABLED=false

# Circuit breaker: consecutive failures before a provider is tripped.
MODEL_RUNTIME_CIRCUIT_FAILURE_THRESHOLD=5

# Circuit breaker: seconds a tripped provider stays open before half-open retry.
MODEL_RUNTIME_CIRCUIT_RECOVERY_TIMEOUT_S=60
