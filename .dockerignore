# Dockerignore for Aether backend builds.
# The Dockerfile uses the repository root as its build context, so this
# excludes artifacts that do not need to be shipped into the image and
# would otherwise bloat the context transfer on every build.

# VCS + tooling
.git/
.github/
.claude/
.vscode/
.idea/
.pre-commit-config.yaml

# Node / workspace artifacts
node_modules/
**/node_modules/
# Keep the backend's canonical JSON contracts available to the image while
# continuing to exclude the rest of the workspace packages.
packages/*
!packages/shared/
!packages/shared/contracts/
!packages/shared/contracts/**
apps/
playground/
RootPackageSDK.json
package-lock.json

# Docs + release artifacts
docs/
CHANGELOG.md
README.md
CONTRIBUTING.md
LICENSE
*.md
!services/backend/**/*.md

# Python byproducts
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
*.egg-info/

# Coverage + test output
coverage/
htmlcov/
.coverage
.coverage.*

# OS + editor cruft
.DS_Store
Thumbs.db
*.swp

# Environment files (pyproject + security come in explicitly via the Dockerfile)
.env
.env.*
!.env.example

# Subsystems not needed for backend image
services/ml/
!services/ml/
!services/ml/common/
!services/ml/common/**
!services/ml/edge/
!services/ml/edge/**
!services/ml/monitoring/
!services/ml/monitoring/**
!services/ml/server/
!services/ml/server/**
!services/ml/serving/
!services/ml/serving/**

# Generated model artifacts must never enter the Docker build context.
services/ml/**/*.onnx
services/ml/**/*.joblib
services/ml/**/*.pkl
services/ml/**/model_output/
services/agents/
contracts/smart-contracts/
Aether Mobile SDK/
docs/archive/legacy-architecture/aws-deployment/
docs/archive/legacy-architecture/data-ingestion-layer/
docs/archive/legacy-architecture/data-lake-architecture/
services/compliance/
tests/
deploy/
cicd/
data-modules/

# Tarballs / archives
*.zip
*.tar
*.tar.gz
