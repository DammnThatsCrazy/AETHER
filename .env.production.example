# ============================================================================
# Aether — PRODUCTION environment example
# Source ALL secrets from a secret manager (never commit real values).
# See docs/PRODUCTION-DEPLOYMENT.md and docs/SECRETS-MANAGEMENT.md.
# ============================================================================

AETHER_ENV=production
DEBUG=false
LOG_LEVEL=info

# --- Required (app fails fast if missing) — inject from secret manager ---
JWT_SECRET=                 # secret-manager ref
DATABASE_URL=               # managed PostgreSQL
BYOK_ENCRYPTION_KEY=        # Fernet key, rotated on schedule
ORACLE_SIGNER_PRIVATE_KEY=
GRAFANA_ADMIN_PASSWORD=

# --- Infra (managed services) ---
# This template targets production-lean, which forbids msk/elasticache/neptune/
# clickhouse (config/deployment_profiles.yaml) — so no kafka/redis/neptune
# defaults appear here. production-scale / enterprise-isolated MAY enable those
# and would override the selector block below (CACHE_BACKEND=redis,
# EVENT_BACKEND=kafka, GRAPH_BACKEND=neptune, ANALYTICS_BACKEND=clickhouse,
# ML_MODE=remote).
EVENT_BROKER=sns_sqs        # must match EVENT_BACKEND (drives shared/events dispatch)
SNS_TOPIC_ARN=
SQS_QUEUE_URL=
CORS_ORIGINS=https://app.[domain]

# --- Secret manager ---
# SECRET_MANAGER_PROVIDER=aws   # secrets sourced from the manager, not env

# --- Feature flags: enable intentionally; new systems default OFF ---
AETHER_DATA_QUALITY_ENABLED=true
KYBER_INTELLIGENCE_QUALITY_ENABLED=true

# --- External billing: enable only after Stripe account + mappings are ready ---
AETHER_EXTERNAL_BILLING_ENABLED=false
AETHER_STRIPE_BILLING_ENABLED=false
KYBER_BILLING_PROVIDER_SYNC_ENABLED=false
BILLING_PROVIDER_MODE=internal_only
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PRODUCT_MAPPING_JSON /
# STRIPE_PRICE_MAPPING_JSON / STRIPE_PORTAL_RETURN_URL — only when stripe enabled.

# --- Connectors (disabled by default; per-connector creds only when enabled) ---
# AETHER_CONNECTOR_<NAME>_ENABLED=false

# --- Partner ecosystem: future-flagged OFF (not implemented) ---
AETHER_PARTNER_ECOSYSTEM_ENABLED=false
AETHER_MARKETPLACE_ENABLED=false
AETHER_DEVELOPER_PLATFORM_ENABLED=false
KYBER_PARTNER_ECOSYSTEM_ENABLED=false

# --- Trust plane (founding-tenant production): human sessions replace human
#     API-key login. These default ON in staging/production; shown here for
#     visibility. Legacy broad tenant registration stays contained (OFF). ---
TRUST_PLANE_ENABLED=true
HUMAN_SESSIONS_ENABLED=true
SERVICE_CREDENTIALS_ENABLED=true
PUBLIC_INGEST_IDENTIFIER_ENABLED=true
LEGACY_TENANT_REGISTRATION_ENABLED=false
# SESSION_IDLE_MINUTES=60
# SESSION_ABSOLUTE_MINUTES=720

# --- Route policy registry (PR 2): authorization as a protocol. The per-route
#     Kyber operator gate is always active. Enforcement is ON in production: the
#     middleware denies unclassified / Kyber-mismatch routes and the
#     founding-tenant manifest's excluded domains are hard-denied. The backend
#     also fails closed at boot (ROUTE_POLICY_ENFORCEMENT_REQUIRED) if any of
#     these three are not true in a deploy target, so they must match
#     config/founding_tenant_release.yaml. ---
POLICY_ENFORCEMENT_ENABLED=true
ROUTE_REGISTRY_ENFORCED=true
KYBER_OPERATOR_GATE_ENFORCED=true
# Protected ML prediction routes (/v1/ml/predict*) fail closed (HTTP 503) when
# no extraction defense is available, instead of serving unprotected.
REQUIRE_EXTRACTION_DEFENSE=true

# --- Runtime roles & backend selectors (PR 4 / FT-4): the API process must not
#     start every worker/consumer/cron. Each process runs ONE explicit role via
#     `python -m services.runtime.run_role <role>`. Production REJECTS
#     AETHER_ROLE=all and in-memory cache/database backends (fail-closed).
#     Roles: api | outbox-relay | stream-worker | identity-worker | graph-writer
#            | measurement-worker | materializer | maintenance. ---
AETHER_ROLE=api             # per-process; workers set their own role
# Canonical profile (config/deployment_profiles.yaml). Must equal the profile
# declared in config/founding_tenant_release.yaml so the release surface,
# excluded-domain denial, and cost policy all resolve to the same product.
DEPLOYMENT_PROFILE=production-lean
WORKER_ROLES_ENABLED=true   # default-on non-local; API process starts no workers
# Backend selectors — durable backends required in production (no "memory").
# Values match canonical production-lean: cache is DynamoDB (elasticache is
# forbidden), event is SNS+SQS (msk forbidden), graph/analytics are Postgres.
DATABASE_BACKEND=aurora_postgres
CACHE_BACKEND=dynamodb
EVENT_BACKEND=sns_sqs
GRAPH_BACKEND=postgres
ANALYTICS_BACKEND=postgres
OBJECT_BACKEND=s3
ML_MODE=inline              # inline | remote
# --- Server-authoritative consent (PR 3): the SERVER consent-receipt store, not
#     the SDK per-event snapshot, decides whether ingestion may process an event.
#     Absence of a server receipt is NOT permission (fail-closed). Default ON in
#     staging/production; shown here for visibility. ---
AUTHORITATIVE_CONSENT_ENFORCEMENT_ENABLED=true
TENANT_COMPLIANCE_POLICY_ENABLED=true

# --- Ingestion V2 (PR 5): typed Bronze + transactional outbox for /v1/batch.
#     Canary rollout — default OFF. Enable globally with INGESTION_V2_ENABLED, or
#     ramp per tenant via INGESTION_V2_CANARY_TENANTS (comma-separated tenant ids).
#     DB uniqueness is the idempotency source of truth (Redis is not). The outbox
#     relay WORKER that drains event_outbox to the bus ships in a later PR; keep
#     OUTBOX_RELAY_ENABLED off until then. ---
INGESTION_V2_ENABLED=false
INGESTION_V2_CANARY_TENANTS=
OUTBOX_RELAY_ENABLED=false
# Relay tuning (PR 6): claim batch, idle poll cadence, claim lease (crashed
# relays release rows when the lease lapses), attempt ceiling → dead_letter.
# The relay runs under the `outbox-relay` runtime role (or in-process under
# `all`) and only when OUTBOX_RELAY_ENABLED=true.
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_POLL_INTERVAL_S=2
OUTBOX_RELAY_LEASE_SECONDS=60
OUTBOX_RELAY_MAX_ATTEMPTS=8

# --- Observation Envelope (WS-A5, Envelope B): canonical server observation
#     model (observation/tenancy/source/subjects[]+trust_class/temporal/...
#     UniversalObservationEnvelope). When ON, /v1/batch ALSO builds an envelope
#     per accepted SDK event and persists it additively as
#     normalized["observation_envelope"] (bus payload + durable Bronze). The flat
#     SDK dict remains the consumption surface until the WS-B gateway converges
#     every adapter onto Envelope B — keep OFF unless running an Envelope-B
#     consumer. ---
AETHER_OBSERVATION_ENVELOPE_ENABLED=false

# --- Universal ingress gateway (WS-B1): when ON together with the
#     observation-envelope flag, /v1/batch ALSO runs each accepted SDK envelope
#     through services/ingestion/gateway.validate_and_stamp (Envelope-B schema +
#     canonical type/family + tenant checks, then credential/source-trust
#     provenance + quality stamping). A rejected envelope degrades to the flat
#     SDK path — keep OFF unless running an Envelope-B consumer. ---
AETHER_UNIVERSAL_INGRESS_GATEWAY_ENABLED=false

# --- Ingestion-level replay (WS-B4): operator-triggered scan-run re-delivery
#     of durable Bronze SDK events through the universal gateway with original-
#     time preservation (Invariant #15). Operators may ALWAYS dry-run (counts
#     only, zero publishes); a REAL run (POST /v1/kyber/ingest/replay/events
#     with dry_run=false) is refused with 403 until this flag is ON. Replay
#     reads Bronze only and republishes SDK_EVENTS_VALIDATED with
#     source_service "ingestion.replay" (the Bronze writer consumer skips
#     those — the durable row already exists). ---
AETHER_INGESTION_REPLAY_ENABLED=false

# --- Storage Plane (PR 7 / FT-7 + PR 8 / FT-8): Elastic Data Plane descriptors,
#     object layer, object-backed Bronze compaction, and cross-store lifecycle.
#     The storage-policy registry (config/storage_policies.yaml) is enforced by CI
#     regardless of these flags; they gate runtime behavior only. Externalization
#     writes packed objects (policy-gated per resource type) to the object store;
#     the reconciler diffs the descriptor index against the object store (scheduled
#     by the bronze_object_compaction worker). The bucket is required (fail-closed)
#     when OBJECT_BACKEND=s3 and externalization is enabled.
#     FT-8 write path: BRONZE_OBJECT_COMPACTION_ENABLED packs cold Bronze payloads
#     (older than BRONZE_COMPACTION_MIN_AGE_HOURS) into objects — hot searchable
#     metadata always stays in Postgres. Compaction requires
#     STORAGE_EXTERNALIZATION_ENABLED=true as well; enable both together.
#     STORAGE_LIFECYCLE_RETENTION_ENABLED lets the retention sweep worker age out
#     externalized objects + Bronze rows per policy retention_class/delete_behavior
#     (retention_class "standard" ages after STORAGE_RETENTION_STANDARD_DAYS;
#     "legal" is never auto-swept; active legal holds always block deletion).
#     All FT-8 flags default OFF. ---
STORAGE_EXTERNALIZATION_ENABLED=false
STORAGE_RECONCILER_ENABLED=false
STORAGE_OBJECT_BUCKET=
BRONZE_OBJECT_COMPACTION_ENABLED=false
BRONZE_COMPACTION_MIN_AGE_HOURS=72
BRONZE_COMPACTION_BATCH_SIZE=500
BRONZE_COMPACTION_INTERVAL_S=3600
STORAGE_LIFECYCLE_RETENTION_ENABLED=false
STORAGE_RETENTION_STANDARD_DAYS=365

# ---------------------------------------------------------------------------
# Kyber workforce identity (Olympus operator plane)
#
# An Olympus operator is NOT an Aether tenant. A production Kyber session
# requires an invite-created workforce principal, a valid Google Workspace
# identity, an approved personal device (WebAuthn credential + browser-bound
# device-proof key + server-issued grant), and a backend-authorized role.
#
# In staging and production, Settings() REFUSES TO START when the workforce
# plane is enabled and the SSO / WebAuthn anchors below are unset, or when any
# of the enforcement flags is disabled, or when bootstrap is left on.
# ---------------------------------------------------------------------------
KYBER_WORKFORCE_IDENTITY_ENABLED=true   # Workforce principals are the production identity
KYBER_DEVICE_TRUST_REQUIRED=true        # Require an approved device for operator authority
KYBER_BACKEND_AUTHZ_ENFORCED=true       # Enforce declared route capabilities at the boundary
KYBER_SCOPE_V2_ENABLED=true                    # Durable, purpose-bound tenant access scopes
KYBER_STEP_UP_REQUIRED=true             # Fresh WebAuthn assertion for high-risk actions
KYBER_LEGACY_OPERATOR_IDENTITY_ALLOWED=false  # Legacy tenant-permission operator path; MUST be false in staging/production
KYBER_SESSION_COOKIE_SECURE=true        # Secure attribute on __Host-kyber_session

# Google Workspace OIDC. The code exchange happens server-side; no token is ever
# exposed to frontend JavaScript.
KYBER_GOOGLE_CLIENT_ID=${KYBER_GOOGLE_CLIENT_ID}
KYBER_GOOGLE_CLIENT_SECRET=${KYBER_GOOGLE_CLIENT_SECRET}
KYBER_GOOGLE_REDIRECT_URI=https://kyber.aether.network/v1/kyber/auth/callback
KYBER_GOOGLE_HOSTED_DOMAIN=olympuslabs.ai              # When set, the `hd` claim must match
KYBER_GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# WebAuthn relying party. RP id and origin must match the Kyber frontend origin.
KYBER_WEBAUTHN_RP_ID=kyber.aether.network
KYBER_WEBAUTHN_RP_NAME=Kyber
KYBER_WEBAUTHN_ORIGIN=https://kyber.aether.network

# Origins permitted to make mutating Kyber requests (CSRF/origin gate).
KYBER_ALLOWED_ORIGINS=https://kyber.aether.network

# One-time founder bootstrap. Refuses to run while ANY workforce principal
# exists, and Settings() refuses staging/production while it is true.
KYBER_BOOTSTRAP_ENABLED=false
KYBER_BOOTSTRAP_FOUNDER_EMAIL=
KYBER_BOOTSTRAP_FOUNDER_GOOGLE_SUBJECT=

# Google Admin SDK reconciliation. When disabled, Kyber cannot learn that a
# Google account was suspended — manual Kyber suspension is then the
# authoritative immediate control. See docs/runbooks/KYBER_WORKFORCE_OFFBOARDING.md
KYBER_DIRECTORY_SYNC_ENABLED=false
KYBER_GOOGLE_ADMIN_ACCESS_TOKEN=
KYBER_DIRECTORY_SYNC_REQUIRED=true   # Deny privileged access when directory state is unverifiable
KYBER_DIRECTORY_MAX_STALE_HOURS=24
KYBER_DIRECTORY_SYNC_INTERVAL_SECONDS=3600

# === Payment-Rail Financial Plane (production posture) ===
# CredentialAuthority is MANDATORY: KMS-backed cipher, no legacy-vault fallback.
# Provision LIVE provider credentials through the credential API; register durable
# /{provider}/{endpoint_id} webhook URLs. Canonical outbox + relay + repair worker
# are enabled together for durable, self-healing canonical delivery. The
# header-tenant webhook route returns 404. Usage metering stays OFF until the
# billing contract is confirmed. Promote a provider from credential-waiting to
# validated only with live evidence (see docs/PAYMENT-RAILS-ACTIVATION.md).
CREDENTIAL_CIPHER=aws_kms
CREDENTIAL_KMS_KEY_ID=            # [REQUIRED] production KMS CMK id/arn (terraform: modules/kms_credentials)
CREDENTIAL_ROTATION_OVERLAP_HOURS=24
AETHER_PAYMENT_RAILS_ENABLED=false                 # master switch (enable per activation checklist, provider-by-provider)
AETHER_PAYMENT_CREDENTIAL_AUTHORITY_ENABLED=true   # mandatory
AETHER_PAYMENT_CANONICAL_OUTBOX_ENABLED=true       # durable canonical delivery
OUTBOX_RELAY_ENABLED=true                          # drains event_outbox (enable WITH the canonical outbox)
AETHER_PAYMENT_CANONICAL_REPAIR_ENABLED=true       # supervised canonical-repair worker
AETHER_PAYMENT_ALERT_EVAL_ENABLED=true             # derived-condition alert evaluator (fires only once the plane is enabled; thresholds via AETHER_PAYMENT_ALERT_* — see .env.example)
AETHER_PAYMENT_USAGE_METERING_ENABLED=false        # keep OFF until the billing contract is confirmed
AETHER_PAYMENT_LEGACY_WEBHOOK_ROUTE_ENABLED=false  # header-tenant route unavailable (404)
