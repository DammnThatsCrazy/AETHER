{
  "uid": "aether-tenant-quotas",
  "title": "Tenant Quotas",
  "tags": ["aether", "tenant", "quotas"],
  "schemaVersion": 36,
  "version": 1,
  "timezone": "utc",
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource"
      },
      {
        "name": "tenant_id",
        "type": "query",
        "label": "Tenant",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "definition": "label_values(tenant_quota_used, tenant_id)",
        "query": "label_values(tenant_quota_used, tenant_id)",
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Top 10 Tenants by Quota Usage %",
      "type": "table",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "topk(10, tenant_quota_used / tenant_quota_limit * 100)",
          "legendFormat": "{{tenant_id}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 80},
              {"color": "red", "value": 95}
            ]
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Value"}, "properties": [
            {"id": "displayName", "value": "Quota Usage %"},
            {"id": "custom.displayMode", "value": "color-background"}
          ]}
        ]
      },
      "transformations": [{"id": "sortBy", "options": {"fields": [{"desc": true, "displayName": "Quota Usage %"}]}}]
    },
    {
      "id": 2,
      "title": "Quota Exhaustion Events per Hour",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (tenant_id) (increase(rl_quota_overage_total{tenant_id=~\"$tenant_id\"}[1h]))",
          "legendFormat": "{{tenant_id}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 3,
      "title": "Quota Used vs Limit by Tenant",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (tenant_id) (tenant_quota_used{tenant_id=~\"$tenant_id\"})",
          "legendFormat": "{{tenant_id}} used"
        },
        {
          "expr": "sum by (tenant_id) (tenant_quota_limit{tenant_id=~\"$tenant_id\"})",
          "legendFormat": "{{tenant_id}} limit"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 4,
      "title": "Rate Limit Hits by Plan Tier",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (plan) (rate(rl_quota_overage_total[5m]))",
          "legendFormat": "{{plan}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 5,
      "title": "Overage Usage by Tenant (24h)",
      "type": "bar",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "topk(15, sum by (tenant_id) (increase(rl_quota_overage_total[24h])))",
          "legendFormat": "{{tenant_id}}",
          "instant": true
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ]
}
