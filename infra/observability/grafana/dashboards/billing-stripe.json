{
  "uid": "aether-billing-stripe",
  "title": "Billing & Stripe",
  "tags": ["aether", "billing", "stripe"],
  "schemaVersion": 36,
  "version": 1,
  "timezone": "utc",
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active Subscriptions by Plan",
      "type": "stat",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"expr": "sum by (plan) (tenant_plan_tier{plan=\"P1\"})", "legendFormat": "P1"},
        {"expr": "sum by (plan) (tenant_plan_tier{plan=\"P2\"})", "legendFormat": "P2"},
        {"expr": "sum by (plan) (tenant_plan_tier{plan=\"P3\"})", "legendFormat": "P3"},
        {"expr": "sum by (plan) (tenant_plan_tier{plan=\"P4\"})", "legendFormat": "P4"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal"}
    },
    {
      "id": 2,
      "title": "Overage Events per Hour",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (plan) (increase(rl_quota_overage_total[1h]))",
          "legendFormat": "{{plan}} overage"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 3,
      "title": "Webhook Processing Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (event_type) (rate(billing_webhook_processed_total[5m]))",
          "legendFormat": "{{event_type}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 4,
      "title": "Stripe API Error Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum by (error_code) (rate(stripe_api_errors_total[5m]))",
          "legendFormat": "{{error_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 1}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Webhook Processing Success Rate",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum(rate(billing_webhook_processed_total{status=\"success\"}[5m])) / sum(rate(billing_webhook_processed_total[5m])) * 100",
          "legendFormat": "Success %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 95},
              {"color": "green", "value": 99}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Total Revenue Events (24h)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {
          "expr": "sum(increase(billing_webhook_processed_total{event_type=~\"invoice.*\"}[24h]))",
          "legendFormat": "Invoice Events"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ]
}
