{
  "expo": {
    "name": "Proof iOS",
    "slug": "proof-ios",
    "scheme": "aether-proof-ios",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.aether.proof.ios",
      "supportsTablet": false
    },
    "android": {
      "package": "com.aether.proof.ios",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "proof.aether.example" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [],
    "extra": {
      "appKind": "proof-ios"
    }
  }
}
