{
  "name": "@aether/proof-reporting",
  "version": "0.1.0-alpha.0",
  "description": "Aether Functionality Proof — report generators for proof results",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "bin": {
    "aether-identity-proof-pack": "./dist/identity-continuity-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "proof-pack": "node dist/identity-continuity-cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aether/shared": "*",
    "@aether/proof-contracts": "*",
    "@aether/proof-runner": "*"
  },
  "devDependencies": {
    "@aether/shared": "*",
    "@aether/proof-contracts": "*",
    "@aether/proof-runner": "*",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
