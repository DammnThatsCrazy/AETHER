{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.invalid/schemas/identity-continuity-pack.schema.json",
  "title": "AETHER Identity Continuity Staging Proof Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proof_id", "generated_at", "commit", "environment", "scenario_run", "evidence", "contract_inventory", "scenarios", "graph_versions", "restatement_jobs", "projection_outcomes", "feature_flags", "ui_evidence"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "proof_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "commit": { "type": "object", "additionalProperties": false, "required": ["sha", "branch"], "properties": { "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" }, "branch": { "type": "string", "minLength": 1 } } },
    "environment": { "type": "object", "additionalProperties": false, "required": ["name", "deployment_id", "observed_at"], "properties": { "name": { "const": "staging" }, "deployment_id": { "type": "string", "minLength": 1 }, "observed_at": { "type": "string", "format": "date-time" } } },
    "scenario_run": { "type": "object", "additionalProperties": false, "required": ["execution_id", "tenant_ref", "deployment_id"], "properties": { "execution_id": { "type": "string", "minLength": 1 }, "tenant_ref": { "type": "string", "minLength": 1 }, "deployment_id": { "type": "string", "minLength": 1 } } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceReference" } },
    "contract_inventory": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "required_contract_ids", "observed_contract_ids"], "properties": { "evidence_id": { "type": "string" }, "required_contract_ids": { "$ref": "#/$defs/stringList" }, "observed_contract_ids": { "$ref": "#/$defs/stringList" } } },
    "scenarios": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "status", "evidence_id", "artifact_evidence_id", "evidence_sha256", "execution_ref", "executed_at"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "enum": ["passed", "failed", "skipped"] }, "evidence_id": { "type": "string" }, "artifact_evidence_id": { "type": "string" }, "evidence_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }, "execution_ref": { "type": "string", "minLength": 1 }, "executed_at": { "type": "string", "format": "date-time" } } } },
    "graph_versions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["tenant_id", "graph", "before", "after", "observed_at", "evidence_id"], "properties": { "tenant_id": { "type": "string", "minLength": 1 }, "graph": { "type": "string", "minLength": 1 }, "before": { "type": "string", "minLength": 1 }, "after": { "type": "string", "minLength": 1 }, "observed_at": { "type": "string", "format": "date-time" }, "evidence_id": { "type": "string" } } } },
    "restatement_jobs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["tenant_id", "job_id", "status", "projection", "source_graph_version", "resulting_graph_version", "completed_at", "evidence_id"], "properties": { "tenant_id": { "type": "string", "minLength": 1 }, "job_id": { "type": "string", "minLength": 1 }, "status": { "enum": ["succeeded", "failed", "pending"] }, "projection": { "type": "string", "minLength": 1 }, "source_graph_version": { "type": "string", "minLength": 1 }, "resulting_graph_version": { "type": "string", "minLength": 1 }, "completed_at": { "type": "string", "format": "date-time" }, "evidence_id": { "type": "string" } } } },
    "projection_outcomes": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["projection", "status", "evidence_id"], "properties": { "projection": { "type": "string", "minLength": 1 }, "status": { "enum": ["completed", "unsupported", "failed"] }, "evidence_id": { "type": "string" } } } },
    "feature_flags": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "values", "required_enabled"], "properties": { "evidence_id": { "type": "string" }, "values": { "type": "object", "additionalProperties": { "type": "boolean" } }, "required_enabled": { "$ref": "#/$defs/stringList" } } },
    "ui_evidence": { "type": "array", "minItems": 2, "items": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["id", "surface", "test_id", "tenant_ref", "evidence_class", "api_mode", "live_staging_claim", "captured_at", "structured_evidence_id", "screenshot_evidence_id"], "properties": { "id": { "type": "string", "minLength": 1 }, "surface": { "enum": ["activation", "review_queue", "profile_360"] }, "test_id": { "type": "string", "minLength": 1 }, "tenant_ref": { "type": "string", "minLength": 1 }, "evidence_class": { "const": "ui_fixture_only" }, "api_mode": { "const": "playwright_route_fixture" }, "live_staging_claim": { "const": false }, "captured_at": { "type": "string", "format": "date-time" }, "structured_evidence_id": { "type": "string", "minLength": 1 }, "screenshot_evidence_id": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "surface", "test_id", "tenant_ref", "deployment_id", "evidence_class", "api_mode", "live_staging_claim", "captured_at", "structured_evidence_id", "screenshot_evidence_id"], "properties": { "id": { "type": "string", "minLength": 1 }, "surface": { "enum": ["activation", "review_queue"] }, "test_id": { "type": "string", "minLength": 1 }, "tenant_ref": { "type": "string", "pattern": "^tenant:[0-9a-f]{32,64}$" }, "deployment_id": { "type": "string", "minLength": 1 }, "evidence_class": { "const": "ui_live_staging" }, "api_mode": { "const": "authenticated_real_backend" }, "live_staging_claim": { "const": true }, "captured_at": { "type": "string", "format": "date-time" }, "structured_evidence_id": { "type": "string", "minLength": 1 }, "screenshot_evidence_id": { "type": "string", "minLength": 1 } } }
    ] } }
  },
  "$defs": {
    "stringList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evidenceReference": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "sha256"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["contract_inventory", "scenario_result", "scenario_artifact", "graph_versions", "restatement_job", "projection_outcome", "feature_flags", "ui_e2e", "ui_e2e_screenshot"] }, "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } } }
  }
}
