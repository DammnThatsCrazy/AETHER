    },
    {
      "id": "duplicate_successful_payment_ids",
      "payment_ids": ["pi_proof_41001", "pi_proof_41001"],
      "expected_distinct_successful_payment_count": 1,
      "reason": "provider_payment_id_upsert_is_idempotent"
    },
    {
      "id": "ledger_failure_then_webhook_retry",
      "payment_ids": ["pi_proof_41001", "pi_proof_41001"],
      "first_delivery": "funding_session_persisted_then_evidence_store_unavailable",
      "retry_behavior": "duplicate_event_retries_idempotent_commerce_evidence_upsert",
      "expected_distinct_successful_payment_count": 1
    },
    {
      "id": "distinct_successful_payments",
      "payment_ids": ["pi_proof_41001", "pi_proof_41001_retry"],
      "expected_state": "multiple_payments",
      "reason": "never_sum_or_count_distinct_payment_ids_as_one_sale"
    },
    {
      "id": "same_payment_id_from_distinct_providers",
      "payments": [
        {"provider": "stripe", "provider_payment_id": "pi_shared"},
        {"provider": "adyen", "provider_payment_id": "pi_shared"}
      ],
      "expected_distinct_successful_payment_count": 2,
      "expected_state": "multiple_payments",
      "reason": "provider_transaction_ids_are_provider_scoped"
    },
    {
      "id": "same_provider_payment_id_with_divergent_amount",
      "deliveries": [
        {"provider": "stripe", "provider_payment_id": "pi_shared", "amount": "49.95"},
        {"provider": "stripe", "provider_payment_id": "pi_shared", "amount": "48.95"}
      ],
      "expected_state": "conflict",
      "expected_original_amount_preserved": "49.95",
      "reason": "provider_payment_identity_cannot_be_silently_rewritten"
    },
    {
      "id": "stale_order_revision_replay",
      "current_source_revision_at": "2026-10-10T11:00:00Z",
      "replayed_source_revision_at": "2026-10-10T10:00:00Z",
