{
  "name": "@aether/proof-fixtures",
  "version": "0.1.0-alpha.0",
  "description": "Aether Functionality Proof Spine — fixture stubs for FPS test scaffolding",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loaders": {
      "types": "./dist/loaders.d.ts",
      "default": "./dist/loaders.js"
    }
  },
  "typesVersions": {
    "*": {
      "loaders": ["./dist/loaders.d.ts"]
    }
  },
  "files": [
    "dist",
    "src",
    "fixtures",
    "loaders.js",
    "loaders.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aether/shared": "*"
  },
  "devDependencies": {
    "@aether/shared": "*",
    "@aether/proof-contracts": "*",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
