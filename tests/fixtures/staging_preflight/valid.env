# Staging preflight — VALID candidate environment fixture.
#
# Used by `python scripts/staging_preflight.py --dry-run` as the known-good
# input: every env check AND the config.settings.Settings() subprocess
# construction must PASS against this file. If a new fail-closed guard is
# added to Settings.__post_init__, extend this fixture (never weaken the
# guard).
#
# All secrets are realistic deterministic dummies (sha256 hex of fixture
# labels) — they are NOT real credentials.

AETHER_ENV=staging
DEBUG=false

# Primary datastore (Settings.__post_init__ requires DATABASE_URL non-local;
# alembic/env.py normalises asyncpg driver prefixes)
DATABASE_URL=postgresql://aether:23e1bdf1a281b966187434b8d0af41cbcc7aa90445010e755040e8badb7b8ff2@db.staging.internal:5432/aether

# Redis — shared durable store + rate limiting (shared/store.py fails closed
# without REDIS_URL/REDIS_HOST outside local mode)
REDIS_HOST=redis.staging.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=aa64362ed2d3cc46d65a667deacebc8e9b0e4f97d5003a9fb3321ef0699dcd65

# CORS — explicit staging origins only (no wildcard, no localhost)
CORS_ORIGINS=https://app.staging.aether.io,https://kyber.staging.aether.io

# Signing / auth secrets (Settings.__post_init__ fail-closed guards)
JWT_SECRET=120db0cde52d9e35fe592a4a87c4fcd766080e6e61914fe5446f655247ac80a2
SDK_CONFIG_SECRET=b59a0e883dd3af053ed24803d045c0e8bf5bb720f92deefae187a692ced6b23e
WATERMARK_SECRET_KEY=d742984fbdbf137d62cb2ec9abcaf71df704200b8cf00b0e4ca5c77baf068ff3
CANARY_SECRET_SEED=7e91c3aae07b2418b32924fd719571973b5414396b12386118f2b95f207bae3f
EXTRACTION_CANARY_SEED=5ff3da6f420ef7b5b38ed207e0908bc555f6b18725c8ce3e484fe3c6308ca5e6

# BYOK vault key (mandatory in production; set in staging for parity)
BYOK_ENCRYPTION_KEY=bd6a6353b868348a449a251b7eb07d9bfaa7831b505e774e8ebfe94ca0c466b9

# Rate-limit pricing option (must be A, B, or C)
PRICING_OPTION=B

# Runtime role (PR 4 / FT-4): staging/production reject AETHER_ROLE=all — the
# API process must run an explicit role. "api" is the HTTP server; worker roles
# run via `python -m services.runtime.run_role <role>`.
AETHER_ROLE=api
