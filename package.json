{
  "name": "aether-sdk",
  "version": "8.9.0",
  "private": true,
  "description": "Aether SDK \u2014 Multi-platform behavioral analytics and Web3 data collection",
  "workspaces": [
    "packages/shared",
    "packages/web",
    "packages/react-native",
    "frontend/aether",
    "frontend/kyber",
    "frontend/shared",
    "frontend/docs"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --noEmit --project packages/web/tsconfig.json && npm run typecheck --workspace=frontend/kyber --if-present && npm run typecheck --workspace=packages/react-native --if-present",
    "clean": "rm -rf packages/*/dist packages/*/node_modules",
    "docs": "typedoc --entryPoints packages/web/src/index.ts --out docs/api",
    "deps:circular": "python scripts/check_circular_deps.py packages/web/src packages/react-native/src frontend/kyber/src",
    "deps:unused": "npx --yes depcheck@^1.4 packages/web && npx --yes depcheck@^1.4 packages/react-native && npx --yes depcheck@^1.4 frontend/kyber"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "typedoc": "^0.25.0",
    "rollup": "^4.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "tslib": "^2.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED"
}
