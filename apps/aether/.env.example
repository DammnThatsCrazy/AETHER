# =============================================================================
# Aether — Customer App
# Copy to .env.local and fill in values for your environment.
# =============================================================================

# Environment mode
# Options: local-mocked | local-live | staging | production
VITE_AETHER_ENV=local-mocked

# Backend API (required for local-live, staging, production)
VITE_API_BASE_URL=http://localhost:8000

# OIDC / Auth (required for staging and production)
VITE_OIDC_AUTHORITY=https://your-auth-provider/.well-known/openid-configuration
VITE_OIDC_CLIENT_ID=your-aether-client-id
VITE_OIDC_REDIRECT_URI=http://localhost:5175/callback
VITE_OIDC_SCOPE=openid profile email
