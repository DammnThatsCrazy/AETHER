# =============================================================================
# Kyber — Operator Console
# Copy to .env.local and fill in values for your environment.
# =============================================================================

# Environment mode
# Options: local-mocked | local-live | staging | production
VITE_KYBER_ENV=local-mocked

# Backend API (required for local-live, staging, production)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_GRAPHQL_URL=http://localhost:8000/v1/analytics/graphql

# OIDC / Auth (required for staging and production)
VITE_OIDC_AUTHORITY=https://your-auth-provider/.well-known/openid-configuration
VITE_OIDC_CLIENT_ID=your-kyber-client-id
VITE_OIDC_REDIRECT_URI=http://localhost:5174/callback
VITE_OIDC_SCOPE=openid profile email groups

# Optional integrations
VITE_SLACK_WEBHOOK_URL=
VITE_AUTOMATION_POSTURE=conservative
VITE_FEATURE_FLAGS={}
