# =============================================================================
# Kyber — Operator Console
# Copy to .env.local and fill in values for your environment.
# =============================================================================

# Environment mode
# Options: local-mocked | local-live | staging | production
VITE_KYBER_ENV=local-mocked

# Backend API (required for local-live, staging, production)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_GRAPHQL_URL=http://localhost:8000/v1/analytics/graphql

# Auth0 / OIDC (required for staging and production)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com        # Auth0 domain (e.g. aether.us.auth0.com)
VITE_AUTH0_CLIENT_ID=                           # Auth0 SPA Client ID
VITE_AUTH0_AUDIENCE=https://api.aether.io       # Auth0 API Audience (matches backend JWT config)
VITE_AUTH0_REDIRECT_URI=http://localhost:5174/callback
VITE_AUTH0_LOGOUT_URI=http://localhost:5174

# Optional integrations
VITE_SLACK_WEBHOOK_URL=
VITE_AUTOMATION_POSTURE=conservative
VITE_FEATURE_FLAGS={}
