{
  "name": "@aether/mobile-core",
  "version": "0.1.0",
  "description": "Aether mobile SDK core \u2014 typed API client, config, and contract re-exports shared by the Aether and Kyber mobile apps. Platform-agnostic (no React Native / Expo dependency).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aether/shared": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
