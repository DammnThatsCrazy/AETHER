    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@types/react": "~18.2.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "src"
  ],
