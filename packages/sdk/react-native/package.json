{
  "name": "@olympuslabs/aether-react-native",
  "version": "0.1.0-alpha.0",
  "description": "Aether SDK for React Native — Unified bridge to native iOS/Android analytics",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@olympuslabs/aether-shared": "^0.1.0-alpha.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-native": "^0.73.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "src",
    "dist",
    "android",
    "ios",
    "aether-react-native.podspec",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DammnThatsCrazy/AETHER.git",
    "directory": "packages/sdk/react-native"
  },
  "homepage": "https://github.com/DammnThatsCrazy/AETHER/tree/main/packages/sdk/react-native"
}
