{
  "name": "@aether/access-kit",
  "version": "0.1.0-alpha.0",
  "description": "Aether tenant entity and agent-access reads plus site-bound canonical intake CLI/MCP bridge.",
  "repository": {
    "type": "git",
    "url": "https://github.com/DammnThatsCrazy/AETHER.git",
    "directory": "packages/access-kit"
  },
  "homepage": "https://github.com/DammnThatsCrazy/AETHER/tree/main/packages/access-kit",
