{
  "name": "@aether/shared",
  "version": "8.10.0",
  "description": "Aether SDK \u2014 canonical shared TypeScript contracts (events, consent, wallet, identity, entities, commerce, agent, capabilities). Single source of truth for Web, React Native, iOS, and Android SDKs.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "*.ts",
    "!*.test.ts",
    "!*.spec.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "vitest": "^1.6.0",
    "typescript": "^5.4.0"
  },
  "license": "UNLICENSED"
}
