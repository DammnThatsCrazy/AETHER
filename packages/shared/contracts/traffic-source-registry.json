  "legacySourceClassAliases": {
    "_comment": "Historical source_class values accepted on read and normalized to canonical values at API boundaries. Only unambiguous aliases live here; ambiguous legacy values ('paid', 'campaign') require full-evidence reclassification via the repair job and pass through unchanged until repaired.",
    "direct": "direct_unknown"
  },
  "legacyPaidChannelMap": {
