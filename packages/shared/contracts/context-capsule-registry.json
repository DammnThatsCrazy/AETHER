{
  "schemaVersion": "1.0.0",
  "contractVersion": "1.0.0",
  "description": "Canonical context-capsule taxonomy for the context plane. Owns location sources and semantics, precision classes, conflict states, context states, retention classes, and capsule transition types. Generated artifacts: packages/shared/context-capsule.ts, Backend Architecture/aether-backend/shared/context_capsule/generated_taxonomy.py, docs/_generated/context-capsule-table.md (via scripts/generate_platform_contracts.py).",
  "locationSources": [
    "server_network_ip",
    "device_coarse",
    "device_precise",
    "verified_venue",
    "tenant_supplied_venue",
    "qr_or_checkin",
    "shipping_address",
    "billing_address",
    "payment_instrument_country",
    "provider_reported",
    "organization_registered",
    "agent_execution_region",
    "server_execution_region",
    "imported_historical"
  ],
  "locationSemantics": [
    "network_egress",
    "likely_physical_presence",
    "verified_physical_presence",
    "declared_address",
    "commercial_destination",
    "billing_jurisdiction",
    "organization_location",
    "execution_region",
    "venue_association",
    "unknown"
  ],
  "precisionClasses": ["country", "region", "city", "coarse_cell", "precise"],
  "conflictStates": ["none", "explainable", "unresolved", "contradictory"],
  "contextStates": [
    "normal_primary",
    "normal_secondary",
    "expected_recurring",
    "temporary_travel",
    "transient",
    "new_context",
    "returning_to_baseline",
    "commute_pattern",
    "network_egress_only",
    "possible_vpn",
    "possible_datacenter",
    "location_uncertain",
    "location_conflict",
    "improbable_transition",
    "not_applicable",
    "suppressed",
    "insufficient_evidence"
  ],
  "retentionClasses": {
    "raw_ip": { "maxHours": 0 },
    "ephemeral_network_token": { "maxHours": 24 },
    "coarse_location_observation": { "maxDays": 30 },
    "precise_location_observation": { "tenantPolicy": true },
    "context_capsule": { "inheritsStrictest": true },
    "derived_baseline": { "aggregateOnly": true }
  },
  "capsuleTransitionTypes": [
    "session_start",
    "device_change",
    "network_change",
    "location_cluster_change",
    "campaign_change",
    "consent_change",
    "identity_resolved",
    "actor_change",
    "journey_handoff",
    "runtime_change",
    "precision_upgrade"
  ]
}
