{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.olympus.dev/schemas/rights-authority.schema.json",
  "title": "AETHER IRRL rights authority records",
  "type": "object",
  "required": ["recordType"],
  "properties": {
    "recordType": {"enum": ["rights_policy_set", "artifact_rights_envelope", "rights_use_request", "rights_decision", "derivation_edge", "rights_impact_graph"]},
    "tenantId": {"type": ["string", "null"]},
    "policySetRef": {"type": ["string", "null"]},
    "envelopeRefs": {"type": "array", "items": {"type": "string"}},
    "lineageSetHash": {"type": ["string", "null"]},
    "decisionId": {"type": ["string", "null"]},
    "outcome": {"enum": ["allow", "deny", "allow_with_obligations", "pending_review", "unavailable"]},
    "signature": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
