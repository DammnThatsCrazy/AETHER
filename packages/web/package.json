{
  "name": "@aether/web",
  "version": "8.9.0",
  "description": "Aether SDK for Web \u2014 Behavioral analytics with thin-client architecture",
  "main": "./dist/aether.cjs.js",
  "module": "./dist/aether.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aether.esm.js",
      "require": "./dist/aether.cjs.js",
      "default": "./dist/aether.esm.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "import": "./dist/health/index.js",
      "require": "./dist/health/index.js",
      "default": "./dist/health/index.js"
    },
    "./lifecycle-payloads": {
      "types": "./dist/types/lifecycle-payloads.d.ts"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "sideEffects": false,
  "license": "UNLICENSED",
  "dependencies": {
    "@aether/shared": "^8.9.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  }
}
