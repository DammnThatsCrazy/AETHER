# ============================================================================
# Aether — STAGING environment example
# Real infra + required secrets. Source secrets from a manager, not this file.
# See docs/PREPRODUCTION-READINESS.md and docs/ENVIRONMENT-VARIABLES.md.
# ============================================================================

AETHER_ENV=staging
DEBUG=false
LOG_LEVEL=info

# --- Required in non-local (app fails fast if missing) ---
JWT_SECRET=                 # from secret manager
DATABASE_URL=               # postgresql://USER:PASS@HOST:5432/aether
BYOK_ENCRYPTION_KEY=        # Fernet key (generate_secrets.py)
ORACLE_SIGNER_PRIVATE_KEY=  # if oracle/proof features enabled

# --- Infra ---
REDIS_HOST=
REDIS_PORT=6379
EVENT_BROKER=kafka          # or sns_sqs
KAFKA_BROKERS=
NEPTUNE_ENDPOINT=           # if graph features enabled
CORS_ORIGINS=https://app.staging.[domain],https://demo.staging.[domain]

# --- Feature flags (enable intentionally in staging) ---
AETHER_DATA_QUALITY_ENABLED=true
KYBER_INTELLIGENCE_QUALITY_ENABLED=true
AETHER_RECOMMENDATIONS_ENABLED=true
AETHER_DECISION_RECORDS_ENABLED=true
AETHER_OUTCOME_FEEDBACK_ENABLED=true
AETHER_PLAYBOOKS_ENABLED=true

# --- External billing (off until validated; keys required only when enabled) ---
AETHER_EXTERNAL_BILLING_ENABLED=false
AETHER_STRIPE_BILLING_ENABLED=false
KYBER_BILLING_PROVIDER_SYNC_ENABLED=false
BILLING_PROVIDER_MODE=internal_only
# STRIPE_SECRET_KEY=  STRIPE_WEBHOOK_SECRET=   (only when stripe enabled)

# --- Connectors (Phase 2; disabled by default; creds only when enabled) ---
# AETHER_CONNECTOR_SLACK_ENABLED=false  ... etc.

# --- Observability / secret manager ---
GRAFANA_ADMIN_PASSWORD=
# SECRET_MANAGER_PROVIDER=aws

# Partner ecosystem stays future-flagged off.
AETHER_PARTNER_ECOSYSTEM_ENABLED=false
KYBER_PARTNER_ECOSYSTEM_ENABLED=false
