# ============================================================================
# Aether — STAGING environment example
# Real infra + required secrets. Source secrets from a manager, not this file.
# See docs/PREPRODUCTION-READINESS.md and docs/ENVIRONMENT-VARIABLES.md.
# ============================================================================

AETHER_ENV=staging
DEBUG=false
LOG_LEVEL=info

# --- Required in non-local (app fails fast if missing) ---
JWT_SECRET=                 # from secret manager
DATABASE_URL=               # postgresql://USER:PASS@HOST:5432/aether
BYOK_ENCRYPTION_KEY=        # Fernet key (generate_secrets.py)
ORACLE_SIGNER_PRIVATE_KEY=  # if oracle/proof features enabled

# --- Infra ---
REDIS_HOST=
REDIS_PORT=6379
EVENT_BROKER=kafka          # or sns_sqs
KAFKA_BROKERS=
NEPTUNE_ENDPOINT=           # if graph features enabled
CORS_ORIGINS=https://app.staging.[domain],https://demo.staging.[domain]

# --- Route policy registry: enforced in staging. The backend fails closed at
#     boot (ROUTE_POLICY_ENFORCEMENT_REQUIRED) unless all three are true in a
#     deploy target. ---
POLICY_ENFORCEMENT_ENABLED=true
ROUTE_REGISTRY_ENFORCED=true
KYBER_OPERATOR_GATE_ENFORCED=true

# --- Runtime role + deployment profile. DEPLOYMENT_PROFILE must be a canonical
#     profile from config/deployment_profiles.yaml (defaults to local if
#     unset, which is wrong for staging). ---
AETHER_ROLE=api             # per-process; workers set their own role
DEPLOYMENT_PROFILE=staging
WORKER_ROLES_ENABLED=true

# --- Feature flags (enable intentionally in staging) ---
AETHER_DATA_QUALITY_ENABLED=true
KYBER_INTELLIGENCE_QUALITY_ENABLED=true
AETHER_RECOMMENDATIONS_ENABLED=true
AETHER_DECISION_RECORDS_ENABLED=true
AETHER_OUTCOME_FEEDBACK_ENABLED=true
AETHER_PLAYBOOKS_ENABLED=true

# --- External billing (off until validated; keys required only when enabled) ---
AETHER_EXTERNAL_BILLING_ENABLED=false
AETHER_STRIPE_BILLING_ENABLED=false
KYBER_BILLING_PROVIDER_SYNC_ENABLED=false
BILLING_PROVIDER_MODE=internal_only
# STRIPE_SECRET_KEY=  STRIPE_WEBHOOK_SECRET=   (only when stripe enabled)

# --- Connectors (Phase 2; disabled by default; creds only when enabled) ---
# AETHER_CONNECTOR_SLACK_ENABLED=false  ... etc.

# --- Observability / secret manager ---
GRAFANA_ADMIN_PASSWORD=
# SECRET_MANAGER_PROVIDER=aws

# Partner ecosystem stays future-flagged off.
AETHER_PARTNER_ECOSYSTEM_ENABLED=false
KYBER_PARTNER_ECOSYSTEM_ENABLED=false

# --- Intelligence Graph feature flags (enable incrementally in staging) ---
# Layer flags control which relationship layers are permitted in traversal.
# Default: all disabled in staging until validated; all enabled in production.
IG_AGENT_LAYER=false         # H2A, A2H, A2A relationship layer (agent edges)
IG_COMMERCE_LAYER=false      # Economic flow edges (PAYS_FOR, TRANSFERS_TO, etc.)
IG_ONCHAIN_LAYER=false       # On-chain / Web3 wallet and protocol edges
IG_X402_LAYER=false          # x402 payment channel edges (SETTLED_VIA x402)
IG_EXPORT_JOBS=false         # Async graph export jobs via Celery (requires task queue)
IG_SEMANTIC_ZOOM=true        # Macro-to-micro graph zoom (cluster→member expansion)
IG_FLEET_GRAPH=true          # Kyber fleet graph and operator tenant-entry endpoints

# ---------------------------------------------------------------------------
# Kyber workforce identity (Olympus operator plane)
#
# An Olympus operator is NOT an Aether tenant. A production Kyber session
# requires an invite-created workforce principal, a valid Google Workspace
# identity, an approved personal device (WebAuthn credential + browser-bound
# device-proof key + server-issued grant), and a backend-authorized role.
#
# In staging and production, Settings() REFUSES TO START when the workforce
# plane is enabled and the SSO / WebAuthn anchors below are unset, or when any
# of the enforcement flags is disabled, or when bootstrap is left on.
# ---------------------------------------------------------------------------
KYBER_WORKFORCE_IDENTITY_ENABLED=true   # Workforce principals are the production identity
KYBER_DEVICE_TRUST_REQUIRED=true        # Require an approved device for operator authority
KYBER_BACKEND_AUTHZ_ENFORCED=true       # Enforce declared route capabilities at the boundary
KYBER_SCOPE_V2_ENABLED=true                    # Durable, purpose-bound tenant access scopes
KYBER_STEP_UP_REQUIRED=true             # Fresh WebAuthn assertion for high-risk actions
KYBER_LEGACY_OPERATOR_IDENTITY_ALLOWED=false  # Legacy tenant-permission operator path; MUST be false in staging/production
KYBER_SESSION_COOKIE_SECURE=true        # Secure attribute on __Host-kyber_session

# Google Workspace OIDC. The code exchange happens server-side; no token is ever
# exposed to frontend JavaScript.
KYBER_GOOGLE_CLIENT_ID=${KYBER_GOOGLE_CLIENT_ID}
KYBER_GOOGLE_CLIENT_SECRET=${KYBER_GOOGLE_CLIENT_SECRET}
KYBER_GOOGLE_REDIRECT_URI=https://kyber.staging.aether.network/v1/kyber/auth/callback
KYBER_GOOGLE_HOSTED_DOMAIN=olympuslabs.ai              # When set, the `hd` claim must match
KYBER_GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# WebAuthn relying party. RP id and origin must match the Kyber frontend origin.
KYBER_WEBAUTHN_RP_ID=kyber.staging.aether.network
KYBER_WEBAUTHN_RP_NAME=Kyber
KYBER_WEBAUTHN_ORIGIN=https://kyber.staging.aether.network

# Origins permitted to make mutating Kyber requests (CSRF/origin gate).
KYBER_ALLOWED_ORIGINS=https://kyber.staging.aether.network

# One-time founder bootstrap. Refuses to run while ANY workforce principal
# exists, and Settings() refuses staging/production while it is true.
KYBER_BOOTSTRAP_ENABLED=false
KYBER_BOOTSTRAP_FOUNDER_EMAIL=
KYBER_BOOTSTRAP_FOUNDER_GOOGLE_SUBJECT=

# Google Admin SDK reconciliation. When disabled, Kyber cannot learn that a
# Google account was suspended — manual Kyber suspension is then the
# authoritative immediate control. See docs/runbooks/KYBER_WORKFORCE_OFFBOARDING.md
KYBER_DIRECTORY_SYNC_ENABLED=false
KYBER_GOOGLE_ADMIN_ACCESS_TOKEN=
KYBER_DIRECTORY_SYNC_REQUIRED=false   # Deny privileged access when directory state is unverifiable
KYBER_DIRECTORY_MAX_STALE_HOURS=24
KYBER_DIRECTORY_SYNC_INTERVAL_SECONDS=3600

# === Payment-Rail Financial Plane (staging posture) ===
# The durable CredentialAuthority is MANDATORY outside local: KMS-backed cipher,
# no legacy-vault fallback. Provision provider credentials (sandbox environment)
# through the credential API; register durable /{provider}/{endpoint_id} webhook
# URLs. Enable the canonical outbox + relay + repair worker TOGETHER so canonical
# delivery is durable and self-healing. The header-tenant webhook route is 404.
CREDENTIAL_CIPHER=aws_kms
CREDENTIAL_KMS_KEY_ID=            # [REQUIRED] staging KMS CMK id/arn (terraform: modules/kms_credentials)
CREDENTIAL_ROTATION_OVERLAP_HOURS=24
AETHER_PAYMENT_RAILS_ENABLED=false                 # master switch (enable per activation checklist)
AETHER_PAYMENT_CREDENTIAL_AUTHORITY_ENABLED=true   # mandatory outside local
AETHER_PAYMENT_CANONICAL_OUTBOX_ENABLED=true       # durable canonical delivery
OUTBOX_RELAY_ENABLED=true                          # drains event_outbox (enable WITH the canonical outbox)
AETHER_PAYMENT_CANONICAL_REPAIR_ENABLED=true       # supervised canonical-repair worker
AETHER_PAYMENT_ALERT_EVAL_ENABLED=true             # derived-condition alert evaluator (fires only once the plane is enabled; thresholds via AETHER_PAYMENT_ALERT_* — see .env.example)
AETHER_PAYMENT_USAGE_METERING_ENABLED=false        # keep OFF until the billing contract is confirmed
AETHER_PAYMENT_LEGACY_WEBHOOK_ROUTE_ENABLED=false  # header-tenant route unavailable (404) outside local
